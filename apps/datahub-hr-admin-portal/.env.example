# Copy to `.env.local` (or set in the build environment). VITE_ variables are embedded in the
# browser bundle: they are PUBLIC — never put secrets here.

# Base URL of the public website that hosts the DataHub Workspace — the ONLY sign-in of this portal. Signed-out
# visitors are sent to <url>/workspace/open/hr-admin/, Sign out goes to <url>/workspace/logout/, and the hidden
# <url>/workspace-session.html keeps this portal's session tied to the Workspace session.
# Development default: http://localhost:3000. A production build without it cannot sign anyone in.
# Deploy both apps on the same site (e.g. subdomains of one domain) so the embedded session check can read the session.
VITE_WORKSPACE_URL=
