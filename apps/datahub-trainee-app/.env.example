# Copy to `.env.local` (or set in the build environment). VITE_ variables are embedded in the browser bundle:
# they are PUBLIC — never put secrets here.

# Origin (and optional path) of the DataHub website, which hosts the Workspace — the ONLY sign-in of this app.
# Development default: http://localhost:3000. A production build without it cannot sign anyone in.
VITE_WORKSPACE_URL=

# DataHub Analytics API origin (public). Development proxies /api to it; production calls it directly, so the deployed
# origin must be in the API's CORS list.
VITE_API_URL=https://datahubanalytics-api-fybyhjerfcd8ekfc.westeurope-01.azurewebsites.net

# Data source: `api` (default, the real backend) or `mock` (the in-browser simulated backend; tests always use it).
VITE_TRAINEE_DATA=
