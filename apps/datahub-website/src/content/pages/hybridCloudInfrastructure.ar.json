"}}},{"kind":"spacer","height":{"xl":{"height":"32px"}}}]},{"kind":"column","width":{"md":6},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"heading","tag":"h4","text":"شركاؤك الموثوق بهم لتحليل البيانات والبنية التحتية والأمان","style":{"xl":{"fontSize":"20px","fontWeight":"600","lineHeight":"28px","color":"rgb(51, 51, 51)","textAlign":"left","maxWidth":"100%","paddingLeft":"34px"}}},{"kind":"spacer","height":{"xl":{"height":"32px"}}},{"kind":"list","variant":"check","items":[{"title":"يمتلك فريقنا خبرة فنية واسعة في تصميم ونشر وإدارة حلول البنية التحتية السحابية، مما يضمن التكامل السلس والأداء الأمثل."},{"title":"بفضل سجلنا الحافل، نجحنا في تنفيذ حلول البنية التحتية السحابية بنجاح لعدد كبير من العملاء في مختلف القطاعات، محققين نتائج ملموسة ومساهمين في التحول الرقمي."},{"title":"سواء كان العملاء بحاجة إلى AWS أو Azure أو Google Cloud أو منصات سحابية أخرى، فإن خبرتنا تمتد عبر عدة مزودين لهذه الخدمات، مما يضمن استفادة العملاء من البنية التحتية السحابية الأنسب لاحتياجاتهم."},{"title":"نحن نعمل باستمرار على تعزيز خبرتنا في التقنيات السحابية المتقدمة ونبقى على اطلاع دائم بآخر التطورات في التكنولوجيا السحابية، الأمر الذي يمكننا من تقديم حلول مبتكرة تدفع بالابتكار وتمنح العملاء ميزة تنافسية."},{"title":"نحن نقدم دعماً شاملاً طوال دورة حياة حلول البنية التحتية السحابية، بما في ذلك التخطيط والتنفيذ والمراقبة والصيانة، مما يضمن سلاسة في عملية التشغيل وتحقيق الفوائد القصوى من البيئة السحابة."}],"style":{"xl":{"textAlign":"left"}},"columns":{"xl":{"gridTemplateColumns":"1","columnGap":"30px","rowGap":"12px"}},"parts":{"item":{"xl":{"fontSize":"15px","fontWeight":"400","lineHeight":"26.1px","color":"rgb(105, 105, 105)","textAlign":"left","paddingLeft":"32px"}},"marker":{"xl":{"fontSize":"15px","fontWeight":"400","lineHeight":"26.1px","color":"rgb(42, 146, 67)","textAlign":"left"}},"title":{"xl":{"fontSize":"16px","fontWeight":"400","lineHeight":"27.84px","color":"rgb(105, 105, 105)","textAlign":"left"}}}}]}]},{"kind":"spacer","height":{"xl":{"height":"80px"}}}]}]},{"kind":"row","id":"tm-row-6af317c176e36","fullWidth":false,"stretchContent":false,"style":{"xl":{}},"separators":[],"columns":[{"kind":"column","width":{"md":12},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"spacer","height":{"xl":{"height":"80px"}}},{"kind":"heading","tag":"h3","text":"أسئلة متكررة","style":{"xl":{"fontSize":"32px","fontWeight":"400","lineHeight":"45.44px","color":"rgb(51, 51, 51)","textAlign":"left","maxWidth":"100%"}}},{"kind":"spacer","height":{"xl":{"height":"30px"}}},{"kind":"accordion","items":[{"title":"ما هي البنية التحتية السحابية الهجينة، وكيف تختلف عن الحلول السحابية الأخرى؟","html":"تجمع البنية التحتية السحابية الهجينة بين البيئتين السحابية العامة والخاصة، مما يسمح للمؤسسات بالاستفادة من فوائد كلاهما مع الحفاظ على التحكم في البيانات الحساسة وأعباء العمل في الموقع."},{"title":"كيف ستستفيد مؤسستي من البنية التحتية للسحابة الهجينة؟","html":"مع البنية التحتية للسحابة الهجينة، يمكنك تحقيق مرونة وقابلية للتوسع وتحسين تكلفة التشغيل من خلال توسيع نطاق الموارد بناءً على الطلب واستخدام الخدمات السحابية الأكثر فعالية من حيث التكلفة."},{"title":"هل يتم ضمان أمان البيانات في إعداد السحابة الهجينة؟","html":"نعم، يعد أمان البيانات أولوية قصوى في حلول البنية التحتية للسحابة الهجينة لدينا. نقوم بتنفيذ إجراءات أمان قوية وضوابط وصول وتشفير لحماية البيانات سواء داخل المؤسسة أو في السحابة."},{"title":"هل يمكنكم دمج البنية التحتية الموجودة لدينا في الموقع مع موارد السحابة بسهولة؟","html":"بالتأكيد، تم تصميم حلول السحابة الهجينة لدينا لدمج البنية التحتية الموجودة لديك مع موارد السحابة بسهولة، مما يتيح عملية ترحيل للمعلومات سلسة وفعالة."},{"title":"كيف ستضمن التنفيذ السلس والناجح للبنية التحتية السحابية الهجينة في مؤسستنا؟","html":"سيقوم فريقنا من مهندسي السحابة من ذوي الخبرة بإجراء تقييم شامل للبنية التحتية وأعباء العمل لديك، ووضع استراتيجية ترحيل مخصصة وتوفير دعم شامل طوال عملية التنفيذ، مما يضمن انتقالًا سلسًا وناجحًا إلى بيئة السحابة الهجينة."}],"style":{"xl":{}},"parts":{"section":{"xl":{"fontSize":"16px","fontWeight":"400","lineHeight":"27.84px","color":"rgb(105, 105, 105)","backgroundColor":"rgb(255, 255, 255)"}},"title":{"xl":{"fontSize":"18px","fontWeight":"500","lineHeight":"22.14px","color":"rgb(255, 255, 255)","paddingTop":"18px","paddingBottom":"18px","backgroundColor":"rgb(0, 68, 147)","borderBottom":"1px solid rgba(0, 0, 0, 0)","paddingLeft":"30px","paddingRight":"30px"}},"content":{"xl":{"fontSize":"16px","fontWeight":"400","lineHeight":"27.84px","color":"rgb(105, 105, 105)","paddingTop":"23px","paddingBottom":"29px","paddingLeft":"30px","paddingRight":"30px"}}}},{"kind":"spacer","height":{"xl":{"height":"100px"},"md":{"height":"50px"}}}]}]}]}
