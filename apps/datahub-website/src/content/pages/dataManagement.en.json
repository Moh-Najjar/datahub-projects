, 255)","borderRadius":"5px","boxShadow":"rgba(51, 51, 51, 0.1) 0px 0px 25px 0px","textAlign":"left"}},"image":{"xl":{"width":"486px"},"md":{"width":"246px"},"xs":{"width":"276px"}},"heading":{"xl":{"fontSize":"28px","fontWeight":"500","lineHeight":"35px","color":"rgb(0, 0, 0)","textAlign":"left","marginBottom":"9px"}},"text":{"xl":{"fontSize":"16px","fontWeight":"400","lineHeight":"27.84px","color":"rgb(105, 105, 105)","textAlign":"left"}},"content":{"xl":{"fontSize":"16px","fontWeight":"400","lineHeight":"27.84px","color":"rgb(105, 105, 105)","textAlign":"left"}}}},{"kind":"box","variant":"image-04","heading":"Data Analytics and Reporting","textHtml":"We transform raw data into valuable insights through advanced analytics techniques and customized reporting solutions. Our service includes the development of dashboards, performance metrics, and interactive reports that provide actionable intelligence, helping organizations make informed decisions, track key performance indicators (KPIs), and identify emerging trends and opportunities.","style":{"xl":{}},"parts":{"wrap":{"xl":{"paddingTop":"50px","paddingRight":"42px","paddingBottom":"56px","paddingLeft":"42px","backgroundColor":"rgb(255, 255, 255)","borderRadius":"5px","boxShadow":"rgba(51, 51, 51, 0.1) 0px 0px 25px 0px","textAlign":"left"}},"image":{"xl":{"width":"486px"},"md":{"width":"246px"},"xs":{"width":"276px"}},"heading":{"xl":{"fontSize":"28px","fontWeight":"500","lineHeight":"35px","color":"rgb(0, 0, 0)","textAlign":"left","marginBottom":"9px"}},"text":{"xl":{"fontSize":"16px","fontWeight":"400","lineHeight":"27.84px","color":"rgb(105, 105, 105)","textAlign":"left"}},"content":{"xl":{"fontSize":"16px","fontWeight":"400","lineHeight":"27.84px","color":"rgb(105, 105, 105)","textAlign":"left"}}}},{"kind":"box","variant":"image-04","heading":"Data Migration","textHtml":"Our Data Migration service ensures the smooth and accurate transfer of data between systems, platforms, or environments. We handle the entire