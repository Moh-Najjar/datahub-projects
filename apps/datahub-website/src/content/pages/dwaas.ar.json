"column","width":{"md":12,"lg":5},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"spacer","height":{"xl":{"height":"50px"},"md":{"height":"30px"}}},{"kind":"heading","tag":"h3","text":"يمكن للمؤسسات توفير ما يصل إلى 50% من وقتها من خلال استخدام حلول مستودعات البيانات الفعالة.","style":{"xl":{"fontSize":"24px","fontWeight":"800","lineHeight":"40.08px","color":"rgb(51, 51, 51)","textAlign":"left","marginBottom":"25px","maxWidth":"400px","paddingLeft":"34px"},"md":{"fontSize":"18px","lineHeight":"30.06px"}}},{"kind":"spacer","height":{"xl":{"height":"100px"},"md":{"height":"30px"}}}]},{"kind":"column","width":{"md":12,"lg":7},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"heading","tag":"div","text":"مع التغيرات التي تواجه الشركات المتمحورة حول البيانات، تجد هذه المؤسسات صعوبة في تحدي تراكم حجم البيانات وتحدي استخراج المعلومات المهمة لدعم عملية اتخاذ القرارات المستنيرة. هنا تظهر فائدة مستودع بيانات كخدمة، التي تخفف من التعقيدات المرتبطة بالاستثمار في، وإدارة البنية التحتية. يقوم مستودع البيانات كخدمة بتمكين المؤسسات بالتركيز على الابتكار والعمليات الأساسية لإدارة الأعمال، وذلك ينتج عن سهولة تخزين البيانات بشكل مركزي وتطبيق التحليلات والتخلص من حاجة إدارة البنية التحتية المكلفة.","style":{"xl":{"fontSize":"17px","fontWeight":"400","lineHeight":"28.39px","color":"rgb(105, 105, 105)","textAlign":"left","maxWidth":"100%"}}},{"kind":"spacer","height":{"xl":{"height":"50px"},"md":{"height":"30px"}}},{"kind":"heading","tag":"div","text":"تتصدر داتا هب انالتكس مجال مستودع البيانات كخدمة، حيث تقدم حلا مصممًا لتلبية احتياجات الشركات المتنوعة في هذا العصر الرقمي. يقوم مستودع البيانات كخدمة لدينا بمعالجة تحديات التوسع والأمان والمرونة، كما يدفع أيضًا المؤسسات إلى استغلال البيانات كأصول استراتيجية وليست كعبء على الإدارة. مع التزامنا بالشفافية والتوسع والتطور التكنولوجي، تضمن داتا هب انالتكس أن تكون رحلتك نحو استراتيجية بيانات أكثر ذكاء وتنقل سريع ليست مجرد ضرورة ولكن أن تكون لها ميزة تنافسية في بيئة العمل السريعة التغير.","style":{"xl":{"fontSize":"17px","fontWeight":"400","lineHeight":"28.39px","color":"rgb(105, 105, 105)","textAlign":"left","maxWidth":"100%"}}},{"kind":"spacer","height":{"xl":{"height":"32px"}}},{"kind":"heading","tag":"h4","text":"تحويل التحديات إلى فرص مع داتا هب انالتكس كالشريك الموثوق به.","style":{"xl":{"fontSize":"20px","fontWeight":"400","lineHeight":"28px","color":"rgb(0, 68, 147)","textAlign":"left","maxWidth":"100%"}}}]}]},{"kind":"row","id":"tm-row-6af31762a2c79","fullWidth":true,"stretchContent":false,"style":{"xl":{"paddingTop":"50px","paddingBottom":"50px"}},"separators":[],"columns":[{"kind":"column","width":{"md":12},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"heading","tag":"h2","text":[{"mark":"الميزات الرئيسية"}],"style":{"xl":{"fontSize":"48px","fontWeight":"400","lineHeight":"56.16px","color":"rgb(51, 51, 51)","textAlign":"center","maxWidth":"930px"},"md":{"fontSize":"36px","lineHeight":"42.12px"}},"markStyle":{"xl":{"fontSize":"48px","fontWeight":"400","lineHeight":"56.16px","color":"rgb(0, 68, 147)","textAlign":"center","display":"inline"},"md":{"fontSize":"36px","lineHeight":"42.12px"}}},{"kind":"spacer","height":{"xl":{"height":"50px"}}},{"kind":"grid","columns":{"xl":{"gridTemplateColumns":"3","columnGap":"20px","rowGap":"40px"},"md":{"gridTemplateColumns":"2"},"xs":{"gridTemplateColumns":"1"}},"gap":{"xl":{"gridTemplateColumns":"3","columnGap":"20px","rowGap":"40px"},"md":{"gridTemplateColumns":"2"},"xs":{"gridTemplateColumns":"1"}},"children":[{"kind":"box","variant":"icon-05","heading":"قابلية التوسع","subHeading":"01","textHtml":"مع نمو الأعمال، يعد التوسع في البنية التحتية للبيانات أمرًا بالغ الأهمية. تم تصميم مستودع البيانات كخدمة من داتا هب انالتكس لمواكبة متطلبات البيانات المتطورة لديك. سواء كنت في مرحلة التوسع السريع أو أنك تواحه تقلبات موسمية، فإن حلنا يتكيف لكل الظروف وفي الوقت الفعلي، مما يضمن أن تبقى بنية البيانات الخاصة بك مرنة ومستجيبة للاحتياجات المتغيرة لعملك.","style":{"xl":{"paddingTop":"19px","paddingBottom":"30px","backgroundColor":"rgb(250, 246, 243)","borderRadius":"5px","paddingLeft":"24px","paddingRight":"24px"}},"parts":{"wrap":{"xl":{"textAlign":"left"}},"heading":{"xl":{"fontSize":"18px","fontWeight":"700","lineHeight":"22.5px","color":"rgb(51, 51, 51)","textAlign":"left"}},"subHeading":{"xl":{"fontSize":"15px","fontWeight":"500","lineHeight":"21.3px","color":"rgb(210, 169, 142)","textAlign":"left","marginBottom":"7px"}},"text":{"xl":{"fontSize":"15px","fontWeight":"400","lineHeight":"26.1px","color":"rgb(105, 105, 105)","textAlign":"left","marginTop":"10px"}},"content":{"xl":{"fontSize":"15px","fontWeight":"400","lineHeight":"26.1px","color":"rgb(105, 105, 105)","textAlign":"left"}}}},{"kind":"box","variant":"icon-05","heading":"أمان البيانات","subHeading":"02","textHtml":"الأمان عنصر أساسي في مستودع البيانات كخدمة. نحن ندرك حساسية بياناتك وحمايتها من أولوياتنا. في داتا هب انالتكس نستخدم بروتوكولات التشفير الحديثة لحماية بياناتك في كل المراحل. نحن نؤمن لك بيئة عمل آمنة، فإن تدابير التشفير لدينا تعمل كدرع لا يخترق، وتحمي بياناتك من الوصول غير المصرح به ومن مخاطر الانتهاك.","style":{"xl":{"paddingTop":"19px","paddingBottom":"30px","backgroundColor":"rgb(237, 242, 254)","borderRadius":"5px","paddingLeft":"24px","paddingRight":"24px"}},"parts":{"wrap":{"xl":{"textAlign":"left"}},"heading":{"xl":{"fontSize":"18px","fontWeight":"700","lineHeight":"22.5px","color":"rgb(51, 51, 51)","textAlign":"left"}},"subHeading":{"xl":{"fontSize":"15px","fontWeight":"500","lineHeight":"21.3px","color":"rgb(78, 132, 250)","textAlign":"left","marginBottom":"7px"}},"text":{"xl":{"fontSize":"15px","fontWeight":"400","lineHeight":"26.1px","color":"rgb(105, 105, 105)","textAlign":"left","marginTop":"10px"}},"content":{"xl":{"fontSize":"15px","fontWeight":"400","lineHeight":"26.1px","color":"rgb(105, 105, 105)","textAlign":"left"}}}},{"kind":"box","variant":"icon-05","heading":"تقنيات التكامل","subHeading":"03","textHtml":"التكامل السلس هو الركيزة الأساسية لإدارة البيانات الفعالة. لذلك تم تصميم حلنا لمستودع البيانات كخدمة ليقوم بالتكامل بسهولة مع مجموعة متنوعة من مصادر البيانات والتطبيقات وأدوات التحليلات. وفي داتا هب انالتكس نضمن أن يعمل نظامك البياني بانسجام، مما يقلل من التضارب في المعلومات ويعزز بيئة عمل صحية تتدفق فيها المعلومات بسلاسة عبر مؤسستك.","style":{"xl":{"paddingTop":"19px","paddingBottom":"30px","backgroundColor":"rgb(240, 245, 244)","borderRadius":"5px","paddingLeft":"24px","paddingRight":"24px"}},"parts":{"wrap":{"xl":{"textAlign":"left"}},"heading":{"xl":{"fontSize":"18px","fontWeight":"700","lineHeight":"22.5px","color":"rgb(51, 51, 51)","textAlign":"left"}},"subHeading":{"xl":{"fontSize":"15px","fontWeight":"500","lineHeight":"21.3px","color":"rgb(114, 164, 153)","textAlign":"left","marginBottom":"7px"}},"text":{"xl":{"fontSize":"15px","fontWeight":"400","lineHeight":"26.1px","color":"rgb(105, 105, 105)","textAlign":"left","marginTop":"10px"}},"content":{"xl":{"fontSize":"15px","fontWeight":"400","lineHeight":"26.1px","color":"rgb(105, 105, 105)","textAlign":"left"}}}},{"kind":"box","variant":"icon-05","heading":"تحليلات الوقت الحقيقي","subHeading":"04","textHtml":"في ساحة العمل السريعة الوتيرة، إمكانية الحصول على المعلومات في الوقت المناسب لا تقدر بثمن. تمنحك مستودع البيانات كخدمة من داتا هب انالتكس إمكانيات التحليل في الوقت الحقيقي، مما يتيح لك اتخاذ القرارات بناءً على معلومات دقيقة وفي أسرع وقت. سواء كنت تراقب الأداء، أو تتتبع الاتجاهات، أو تستجيب للتغيرات في السوق، فإن حلنا يضمن أن تكون تحليلاتك انعكاس ديناميكي للحاضر وليست مجرد تاريخية.","style":{"xl":{"paddingTop":"19px","paddingBottom":"30px","backgroundColor":"rgb(255, 245, 246)","borderRadius":"5px","paddingLeft":"24px","paddingRight":"24px"}},"parts":{"wrap":{"xl":{"textAlign":"left"}},"heading":{"xl":{"fontSize":"18px","fontWeight":"700","lineHeight":"22.5px","color":"rgb(51, 51, 51)","textAlign":"left"}},"subHeading":{"xl":{"fontSize":"15px","fontWeight":"500","lineHeight":"21.3px","color":"rgb(231, 68, 91)","textAlign":"left","marginBottom":"7px"}},"text":{"xl":{"fontSize":"15px","fontWeight":"400","lineHeight":"26.1px","color":"rgb(105, 105, 105)","textAlign":"left","marginTop":"10px"}},"content":{"xl":{"fontSize":"15px","fontWeight":"400","lineHeight":"26.1px","color":"rgb(105, 105, 105)","textAlign":"left"}}}},{"kind":"box","variant":"icon-05","heading":"كفاءة التكلفة","subHeading":"05","textHtml":"يجب ألا تكون إدارة البيانات عبء ماليًا. مع مستودع البيانات كخدمة من داتا هب انالتكس، يكون التركيز على كفاءة التكلفة جزء من حلنا. من خلال القضاء على الحاجة إلى استثمارات ضخمة في البنية التحتية الموجودة في المواقع وتقديم استراتيجيات تسعير شفافة، نضمن أن تقوم بتحسين التكاليف دون التنازل عن الجودة أو تعمق خدمات البيانات الخاصة بك. دع استراتيجية بياناتك تزدهر دون قيود التكاليف المفرطة.","style":{"xl":{"paddingTop":"19px","paddingBottom":"30px","backgroundColor":"rgb(252, 247, 238)","borderRadius":"5px","paddingLeft":"24px","paddingRight":"24px"}},"parts":{"wrap":{"xl":{"textAlign":"left"}},"heading":{"xl":{"fontSize":"18px","fontWeight":"700","lineHeight":"22.5px","color":"rgb(51, 51, 51)","textAlign":"left"}},"subHeading":{"xl":{"fontSize":"15px","fontWeight":"500","lineHeight":"21.3px","color":"rgb(229, 179, 93)","textAlign":"left","marginBottom":"7px"}},"text":{"xl":{"fontSize":"15px","fontWeight":"400","lineHeight":"26.1px","color":"rgb(105, 105, 105)","textAlign":"left","marginTop":"10px"}},"content":{"xl":{"fontSize":"15px","fontWeight":"400","lineHeight":"26.1px","color":"rgb(105, 105, 105)","textAlign":"left"}}}},{"kind":"box","variant":"icon-05","heading":"عمليات تكنولوجيا المعلومات المدارة","subHeading":"05","textHtml":"استمتع بعمليات تكنولوجيا المعلومات الخالية من المتاعب مع حلول مستودع البيانات كخدمة من داتا هب انالتكس. قد يكون التعامل مع تعقيدات صيانة البنية التحتية المعقدة وتحسينها واستكشاف أخطائها وإصلاحها مهمة شاقة لعمليات تكنولوجيا المعلومات. تقوم حلول مستودع البيانات كخدمة الخاصة بنا بنقل هذا العبء بسلاسة إلى فريق الخبراء لدينا. نحن لا نضع قوة إدارة البيانات في متناول يدك فحسب، بل نعمل أيضًا على تبسيط وتقليل تعقيد عمليات تكنولوجيا المعلومات المرتبطة بتخزين البيانات.","style":{"xl":{"paddingTop":"19px","paddingBottom":"30px","backgroundColor":"rgb(252, 247, 238)","borderRadius":"5px","paddingLeft":"24px","paddingRight":"24px"}},"parts":{"wrap":{"xl":{"textAlign":"left"}},"heading":{"xl":{"fontSize":"18px","fontWeight":"700","lineHeight":"22.5px","color":"rgb(51, 51, 51)","textAlign":"left"}},"subHeading":{"xl":{"fontSize":"15px","fontWeight":"500","lineHeight":"21.3px","color":"rgb(229, 179, 93)","textAlign":"left","marginBottom":"7px"}},"text":{"xl":{"fontSize":"15px","fontWeight":"400","lineHeight":"26.1px","color":"rgb(105, 105, 105)","textAlign":"left","marginTop":"10px"}},"content":{"xl":{"fontSize":"15px","fontWeight":"400","lineHeight":"26.1px","color":"rgb(105, 105, 105)","textAlign":"left"}}}}]}]}]},{"kind":"row","id":"tm-row-6af31762a4b3c","fullWidth":true,"stretchContent":false,"style":{"xl":{"backgroundColor":"rgb(248, 248, 248)"}},"separators":[{"position":"bottom","viewBox":"0 0 2.23333 0.1","paths":["M2.23281 0.0372047c0,0 -0.0261929,-0.000389764 -0.0423307,-0.00584252 0,0 -0.0356181,0.0278268 -0.0865354,0.0212205 0,0 -0.0347835,-0.00524803 -0.0579094,-0.0283701 0,0 -0.0334252,0.0112677 -0.0773425,-0.00116929 0,0 -0.0590787,0.0524724 -0.141472,0.000779528 0,0 -0.0288189,0.0189291 -0.0762362,0.0111535 -0.00458268,0.0141024 -0.0150945,0.040122 -0.0656811,0.0432598 -0.0505866,0.0031378 -0.076126,-0.0226614 -0.0808425,-0.0308228 -0.00806299,0.000854331 -0.0819961,0.0186969 -0.111488,-0.022815 -0.0076378,0.0114843 -0.059185,0.0252598 -0.083563,-0.000385827 -0.0295945,0.0508661 -0.111996,0.0664843 -0.153752,0.019 -0.0179843,0.00227559 -0.0571181,0.00573622 -0.0732795,-0.0152953 -0.027748,0.0419646 -0.110602,0.0366654 -0.138701,0.00688189 0,0 -0.0771732,0.0395709 -0.116598,-