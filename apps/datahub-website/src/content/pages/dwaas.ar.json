px"}},"heading":{"xl":{"fontSize":"28px","fontWeight":"500","lineHeight":"35px","color":"rgb(0, 0, 0)","textAlign":"left","marginBottom":"9px"}},"text":{"xl":{"fontSize":"16px","fontWeight":"400","lineHeight":"27.84px","color":"rgb(105, 105, 105)","textAlign":"left"}},"content":{"xl":{"fontSize":"16px","fontWeight":"400","lineHeight":"27.84px","color":"rgb(105, 105, 105)","textAlign":"left"}}}},{"kind":"box","variant":"image-04","heading":"نماذج نشر مرنة","textHtml":"المرونة في نشر البيانات أمر في بالغ الأهمية. يطبق مستودع البيانات كخدمة لدى داتا هب انالتكس مجموعة من نماذج النشر، سواء كنت تفضل نهجًا قائمًا بالكامل على السحابة، أو حل في الموقع، أو نموذجًا هجينًا يجمع بين أفضل ما في العالمين. تضمن مرونتنا أن استراتيجية بياناتك تتماشى مع البنية التحتية للشركة والنهج المفضل لها.","style":{"xl":{}},"parts":{"wrap":{"xl":{"paddingTop":"50px","paddingBottom":"56px","backgroundColor":"rgb(255, 255, 255)","borderRadius":"5px","boxShadow":"rgba(51, 51, 51, 0.1) 0px 0px 25px 0px","textAlign":"left","paddingLeft":"42px","paddingRight":"42px"}},"image":{"xl":{"width":"286px"},"md":{"width":"606px"},"xs":{"width":"276px"}},"heading":{"xl":{"fontSize":"28px","fontWeight":"500","lineHeight":"35px","color":"rgb(0, 0, 0)","textAlign":"left","marginBottom":"9px"}},"text":{"xl":{"fontSize":"16px","fontWeight":"400","lineHeight":"27.84px","color":"rgb(105, 105, 105)","textAlign":"left"}},"content":{"xl":{"fontSize":"16px","fontWeight":"400","lineHeight":"27.84px","color":"rgb(105, 105, 105)","textAlign":"left"}}}},{"kind":"box","variant":"image-04","heading":"خدمات إضافية","textHtml":"يمكنك تعزيز قدرات مستودع البيانات كخدمة الخاصة بك بمجموعتنا المختارة من الخدمات الإضافية. سواء كانت التحليلات المتقدمة أو التعلم الآلي أو طبقات أمان إضافية، في داتا هب انالتكس نوفر مجموعة من الخدمات الإضافية التي تعزز قدرات إدارة بياناتك. قم باختيار تجربة البيانات كخدمة الخاصة بك باستخدام الخدمات التي تكمل أهداف عملك وتدعم استراتيجية الحصول على البيانات الخاصة بك لرفعها إلى مستويات جديدة.","style":{"xl":{}},"parts":{"wrap":{"xl":{"paddingTop":"50px","paddingBottom":"56px","backgroundColor":"rgb(255, 255, 255)","borderRadius":"5px","boxShadow":"rgba(51, 51, 51, 0.1) 0px 0px 25px 0px","textAlign":"left","paddingLeft":"42px","paddingRight":"42px"}},"image":{"xl":{"width":"286px"},"md":{"width":"606px"},"xs":{"width":"276px"}},"heading":{"xl":{"fontSize":"28px","fontWeight":"500","lineHeight":"35px","color":"rgb(0, 0, 0)","textAlign":"left","marginBottom":"9px"}},"text":{"xl":{"fontSize":"16px","fontWeight":"400","lineHeight":"27.84px","color":"rgb(105, 105, 105)","textAlign":"left"}},"content":{"xl":{"fontSize":"16px","fontWeight":"400","lineHeight":"27.84px","color":"rgb(105, 105, 105)","textAlign":"left"}}}}]},{"kind":"spacer","height":{"xl":{"height":"150px"}}}]}]},{"kind":"row","id":"tm-row-6af31762a98e1","fullWidth":true,"stretchContent":false,"style":{"xl":{"paddingBottom":"50px"}},"separators":[],"columns":[{"kind":"column","width":{"md":12},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"spacer","height":{"xl":{"height":"80px"}}},{"kind":"row","id":"tm-row-inner-6af31762aa3c2","fullWidth":false,"stretchContent":false,"style":{"xl":{}},"separators":[],"align":"middle","columns":[{"kind":"column","width":{"md":6},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"heading","tag":"h4","text":"لماذا","style":{"xl":{"fontSize":"40px","fontWeight":"400","lineHeight":"56px","color":"rgb(51, 51, 51)","textAlign":"center","maxWidth":"570px","display":"inline-block"},"md":{"fontSize":"28px","lineHeight":"39.2px"}}},{"kind":"spacer","height":{"xl":{"height":"32px"}}},{"kind":"image","image":{"src":"/assets/uploads/2023/07/databubanalytics_logo_2.png","alt":"databubanalytics_logo_2","width":746,"height":136},"style":{"xl":{"textAlign":"right"}},"imageStyle":{"xl":{"width":"570px","maxWidth":"100%"},"md":{"width":"330px"},"xs":{"width":"360px"}}}]},{"kind":"column","width":{"md":6},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"heading","tag":"h4","text":"شركاؤك الموثوق بهم لتحليلات البيانات والبنية الأساسية والأمان","style":{"xl":{"fontSize":"20px","fontWeight":"600","lineHeight":"28px","color":"rgb(51, 51, 51)","textAlign":"left","maxWidth":"100%","paddingLeft":"34px"}}},{"kind":"spacer","height":{"xl":{"height":"32px"}}},{"kind":"list","variant":"check","items":[{"title":"بدعم من سنوات من الخبرة في الصناعة، تقف داتا هب انالتكس كشركة رائدة في مجال حلول مستودع البيانات كخدمة، حيث تقدم معرفة عميقة تُترجم إلى حلول قوية وموثوقة."},{"title":"تعكس خبرتنا الواسعة في إدارة البيانات التزامنا بالبقاء في الطليعة، ونقدم لك الحلول المتطورة التي تدفع التقدم التكنولوجي."},{"title":"إن تاريخنا في هذا المجال هو شهادة على التزامنا بتقديم خدمات إدارة بيانات آمنة وقابلة للتطوير وفعالة."},{"title":"تتحدث قصص نجاحنا عن النتائج الملموسة ونمو الأعمال الذي تحقق من خلال الشراكة معنا."},{"title":"يضمن تطورنا المستمر أن يستفيد عملاؤنا دائمًا من أحدث التطورات، مما يوفر لهم ميزة تنافسية في المشهد المتغير باستمرار لإدارة البيانات."}],"style":{"xl":{"textAlign":"left"}},"columns":{"xl":{"gridTemplateColumns":"1","columnGap":"30px","rowGap":"12px"}},"parts":{"item":{"xl":{"fontSize":"15px","fontWeight":"400","lineHeight":"26.1px","color":"rgb(105, 105, 105)","textAlign":"left","paddingLeft":"32px"}},"marker":{"xl":{"fontSize":"15px","fontWeight":"400","lineHeight":"26.1px","color":"rgb(42, 146, 67)","textAlign":"left"}},"title":{"xl":{"fontSize":"16px","fontWeight":"400","lineHeight":"27.84px","color":"rgb(105, 105, 105)","textAlign":"left"}}}}]}]},{"kind":"spacer","height":{"xl":{"height":"80px"}}}]}]},{"kind":"row","id":"tm-row-6af31762c32d3","fullWidth":false,"stretchContent":false,"style":{"xl":{}},"separators":[],"columns":[{"kind":"column","width":{"md":12},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"spacer","height":{"xl":{"height":"80px"}}},{"kind":"heading","tag":"h3","text":"الأسئلة المتكررة","style":{"xl":{"fontSize":"32px","fontWeight":"400","lineHeight":"45.44px","color":"rgb(51, 51, 51)","textAlign":"left","maxWidth":"100%"}}},{"kind":"spacer","height":{"xl":{"height":"30px"}}},{"kind":"accordion","items":[{"title":"ما هو تخزين البيانات كخدمة (DWaaS)، وكيف يختلف عن تخزين البيانات التقليدي؟","html":"مستودع البيانات كخدمة هو حل قائم على السحابة يوفر نظامًا أساسيًا مُدارًا بالكامل لتخزين البيانات ومعالجتها وتحليلاتها. على عكس تخزين البيانات التقليدية، توفر حلول مستودع البيانات كخدمة قدرًا أكبر من قابلية التوسع والمرونة وفعالية التكلفة من خلال التخلص من الحاجة إلى بنية تحتية محلية وتوفير تكامل سلس مع الخدمات السحابية."},{"title":"ما هي الصناعات التي تستفيد أكثر من حل مستودع البيانات كخدمة الخاص بـداتا هب انالتكس؟","html":"تلبي حلول مستودع البيانات كخدمة الخاصة بـداتا هب أنالتكس مجموعة متنوعة من الصناعات، بما في ذلك على سبيل المثال لا الحصر البيع بالتجزئة والرعاية الصحية والتمويل والتصنيع. إن مرونته وقابلية التوسع تجعله مناسبًا للمؤسسات عبر مختلف القطاعات التي تهدف إلى تحسين عمليات إدارة البيانات الخاصة بها."},{"title":"كيف تضمن داتا هب انالتكس أمان بياناتي في السحابة؟","html":"تستخدم داتا هب انالتكس تدابير أمنية قوية، بما في ذلك التشفير المتقدم، وعناصر التحكم في الوصول الدقيقة، والالتزام بالامتثال، والتعافي الشامل من الكوارث. تعمل هذه الإجراءات بشكل جماعي على حماية بياناتك، مما يضمن السرية والنزاهة والتوافر طوال دورة حياتها."},{"title":"هل يمكنني تخصيص حل مستودع البيانات كخدمة الخاص بـدات هب انالتكس ليناسب الاحتياجات المحددة لمؤسستي؟","html":"نعم، توفر داتا هب انالتكس خيارات تخصيص واسعة النطاق. بدءًا من الحلول المخصصة التي تعالج تحديات البيانات الفريدة ووصولاً إلى نماذج النشر المرنة، يمكنك تشكيل حل مستودع البيانات كخدمةوفقًا للمتطلبات والتفضيلات المحددة لمؤسستك."},{"title":"ما نوع الدعم والتدريب الذي توفره داتا هب انالتكس لمستخدمي مستودع البيانات كخدمة؟","html":"توفر داتا هب انالتكس خدمات دعم وتدريب شاملة. سواء أكان الأمر يتعلق بالمساعدة في الإعداد، أو استكشاف الأخطاء وإصلاحها، أو جلسات التدريب المستمر، فإن هدفنا هو التأكد من أن فريقك مجهز جيدًا لتحقيق أقصى قدر من فوائد مستودع البيانات كخدمة والتغلب على أي تحديات بفعالية."}],"style":{"xl":{}},"parts":{"section":{"xl":{"fontSize":"16px","fontWeight":"400","lineHeight":"27.84px","color":"rgb(105, 105, 105)","backgroundColor":"rgb(255, 255, 255)"}},"title":{"xl":{"fontSize":"18px","fontWeight":"500","lineHeight":"22.14px","color":"rgb(255, 255, 255)","paddingTop":"18px","paddingBottom":"18px","backgroundColor":"rgb(0, 68, 147)","borderBottom":"1px solid rgba(0, 0, 0, 0)","paddingLeft":"30px","paddingRight":"30px"}},"content":{"xl":{"fontSize":"16px","fontWeight":"400","lineHeight":"27.84px","color":"rgb(105, 105, 105)","paddingTop":"23px","paddingBottom":"29px","paddingLeft":"30px","paddingRight":"30px"}}}},{"kind":"spacer","height":{"xl":{},"md":{"height":"70px"}}},{"kind":"spacer","height":{"xl":{"height":"100px"}}}]}]}]}
