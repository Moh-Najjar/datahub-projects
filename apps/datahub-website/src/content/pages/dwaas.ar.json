:{"fontSize":"15px","fontWeight":"400","lineHeight":"26.1px","color":"rgb(105, 105, 105)","textAlign":"left","marginTop":"10px"}},"content":{"xl":{"fontSize":"15px","fontWeight":"400","lineHeight":"26.1px","color":"rgb(105, 105, 105)","textAlign":"left"}}}},{"kind":"box","variant":"icon-05","heading":"معايير الامتثال","textHtml":"في داتا هب انالتكس نقوم تبسيط عملية فهم التشريعات المتعلقة بالبيانات.يلتزم مستودع البيانات كخدمة لدينا بمعايير الامتثال الصارمة، مما يضمن أن الممارسات المتعلقة بإدارة بياناتك تتماشى مع التشريعات الخاصة بالشركة والمعايير العالمية. سواء كان الأمر يتعلق بـ GDPR أو HIPAA أو أي تنظيمات أخرى، فثق في التزامنا بمعايير الامتثال بهدف حماية مؤسستك من المخاطر القانونية والسمعة السيئة.","style":{"xl":{"paddingTop":"19px","paddingBottom":"30px","backgroundColor":"rgb(240, 245, 244)","borderRadius":"5px","paddingLeft":"24px","paddingRight":"24px"}},"parts":{"wrap":{"xl":{"textAlign":"left"}},"heading":{"xl":{"fontSize":"18px","fontWeight":"700","lineHeight":"22.5px","color":"rgb(51, 51, 51)","textAlign":"left"}},"text":{"xl":{"fontSize":"15px","fontWeight":"400","lineHeight":"26.1px","color":"rgb(105, 105, 105)","textAlign":"left","marginTop":"10px"}},"content":{"xl":{"fontSize":"15px","fontWeight":"400","lineHeight":"26.1px","color":"rgb(105, 105, 105)","textAlign":"left"}}}},{"kind":"box","variant":"icon-05","heading":"ادارة الكوارث","textHtml":"تقدم آليات ادارة الكوارث القوية في داتا هب انالتكس خدمة فريدة من نوعها. يتضمن مستودع البيانات كخدمة لدينا استراتيجيات شاملة لإدارة الكوارث، مما يضمن استمرارية عمليات البيانات الخاصة بك ومواجهة الأحداث غير المتوقعة. نقدم شبكة أمان تقلل من وقت انقطاع الانترنت وتحمي مؤسستك من العواقب المحتملة لفقدان البيانات أو فشل النظام وتغطي جميع الكوارث المحتملة من نسخ البيانات إلى فشل في الأنظمة الاحتياطية. اطمئن، وكن على يقين أن بياناتك محمية وأن مؤسستك مستعدة لأي حدث غير متوقع.","style":{"xl":{"paddingTop":"19px","paddingBottom":"30px","backgroundColor":"rgb(255, 245, 246)","borderRadius":"5px","paddingLeft":"24px","paddingR