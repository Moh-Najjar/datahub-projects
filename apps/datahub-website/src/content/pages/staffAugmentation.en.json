t":"initial"}},"children":[{"kind":"heading","tag":"h4","text":"Why","style":{"xl":{"fontSize":"40px","fontWeight":"400","lineHeight":"56px","color":"rgb(51, 51, 51)","textAlign":"center","maxWidth":"570px","display":"inline-block"},"md":{"fontSize":"28px","lineHeight":"39.2px"}}},{"kind":"spacer","height":{"xl":{"height":"32px"}}},{"kind":"image","image":{"src":"/assets/uploads/2023/07/databubanalytics_logo_2.png","alt":"databubanalytics_logo_2","width":746,"height":136},"style":{"xl":{"textAlign":"left"}},"imageStyle":{"xl":{"width":"570px","maxWidth":"100%"},"md":{"width":"330px"},"xs":{"width":"360px"}}},{"kind":"spacer","height":{"xl":{"height":"32px"}}}]},{"kind":"column","width":{"md":6},"style":{"xl":{"paddingRight":"15px","paddingLeft":"15px"},"xs":{"paddingRight":"initial","paddingLeft":"initial"}},"children":[{"kind":"heading","tag":"h4","text":"Your Trusted Partner for Data Analytics, Infrastructure, and Security","style":{"xl":{"fontSize":"20px","fontWeight":"600","lineHeight":"28px","color":"rgb(51, 51, 51)","textAlign":"left","maxWidth":"100%","paddingLeft":"34px"}}},{"kind":"spacer","height":{"xl":{"height":"32px"}}},{"kind":"list","variant":"check","items":[{"title":"Our team of skilled professionals brings deep knowledge and experience in various data analytics domains."},{"title":"We provide customized analytics strategies designed to meet your specific business needs and goals."},{"title":"We leverage the latest tools and technologies to deliver advanced data solutions and drive innovation."},{"title":"Our staff augmentation services offer the flexibility to scale your team and resources as needed."},{"title":"We focus on delivering actionable insights and measurable outcomes to enhance your business performance."}],"style":{"xl":{"textAlign":"left"}},"columns":{"xl":{"gridTemplateColumns":"1","columnGap":"30px","rowGap":"12px"}},"parts":{"item":{"xl":{"fontSize":"15px","fontWeight":"400","lineHeight":"26.1px","color":"rgb(105, 105, 105)","textAlign":"left","paddingLeft":"32px"}},"marker":{"xl":{"fontSize":"15px","fontWeight":"400","lineHeight":"26.1px","color":"rgb(42, 146, 67)","textAlign":"left"}},"title":{"xl":{"fontSize":"16px","fontWeight":"400","lineHeight":"27.84px","color":"rgb(105, 105, 105)","textAlign":"left"}}}}]}]},{"kind":"spacer","height":{"xl":{"height":"80px"}}}]}]},{"kind":"row","id":"tm-row-6af318ec894a3","fullWidth":false,"stretchContent":false,"style":{"xl":{}},"separators":[],"columns":[{"kind":"column","width":{"md":12},"style":{"xl":{"paddingRight":"15px","paddingLeft":"15px"},"xs":{"paddingRight":"initial","paddingLeft":"initial"}},"children":[{"kind":"spacer","height":{"xl":{"height":"80px"}}},{"kind":"heading","tag":"h3","text":"FAQs","style":{"xl":{"fontSize":"32px","fontWeight":"400","lineHeight":"45.44px","color":"rgb(51, 51, 51)","textAlign":"left","maxWidth":"100%"}}},{"kind":"spacer","height":{"xl":{"height":"30px"}}},{"kind":"accordion","items":[{"title":"What is staff augmentation and how does it work?","html":"Staff augmentation is a flexible hiring strategy that enables businesses to temporarily add skilled professionals to their teams for specific projects or periods. These augmented staff members integrate into your existing team and operate under your management, providing specialized expertise without the need for long-term employment commitments."},{"title":"How does staff augmentation differ from traditional outsourcing?","html":"Unlike traditional outsourcing, where an external provider handles entire functions or projects independently, staff augmentation allows you to retain control over the work. The augmented staff members act as an extension of your internal team, working directly with your in-house professionals, ensuring seamless collaboration and alignment with your business goals."},{"title":"What are the benefits of data analytics staff augmentation?","html":"The main benefits include quick access to top-tier data analytics talent, the ability to scale your team based on project needs, and reduced overhead costs compared to full-time hiring. Staff augmentation also offers flexibility, allowing you to bring in experts for specific projects like data science, machine learning, or big data without long-term commitments."},{"title":"How quickly can augmented staff be onboarded?","html":"Typically, the onboarding process for augmented staff can be completed within 1-2 weeks, depending on the complexity of your requirements. This rapid timeline helps minimize project delays and ensures that you can quickly access the skills you need to meet deadlines and project goals."},{"title":"How do we ensure that augmented staff are a good fit for our team?","html":"All professionals provided through staff augmentation undergo a rigorous screening process, including skill assessments and interviews, to ensure they meet your technical and cultural requirements. We work closely with you to match the right talent to your specific project needs, ensuring a seamless fit within your team."}],"style":{"xl":{}},"parts":{"section":{"xl":{"fontSize":"16px","fontWeight":"400","lineHeight":"27.84px","color":"rgb(105, 105, 105)","backgroundColor":"rgb(255, 255, 255)"}},"title":{"xl":{"fontSize":"18px","fontWeight":"500","lineHeight":"22.14px","color":"rgb(255, 255, 255)","paddingTop":"18px","paddingBottom":"18px","paddingLeft":"30px","paddingRight":"30px","backgroundColor":"rgb(0, 68, 147)","borderBottom":"1px solid rgba(0, 0, 0, 0)"}},"content":{"xl":{"fontSize":"16px","fontWeight":"400","lineHeight":"27.84px","color":"rgb(105, 105, 105)","paddingTop":"23px","paddingBottom":"29px","paddingLeft":"30px","paddingRight":"30px"}}}},{"kind":"spacer","height":{"xl":{"height":"100px"},"md":{"height":"50px"}}}]}]}]}
