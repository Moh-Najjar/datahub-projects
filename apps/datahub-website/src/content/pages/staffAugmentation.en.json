ting reporting tools, our BI developers help you visualize key metrics and improve business performance.","style":{"xl":{}},"parts":{"wrap":{"xl":{"paddingTop":"50px","paddingRight":"42px","paddingBottom":"56px","paddingLeft":"42px","backgroundColor":"rgb(255, 255, 255)","borderRadius":"5px","boxShadow":"rgba(51, 51, 51, 0.1) 0px 0px 25px 0px","textAlign":"left"}},"image":{"xl":{"width":"486px"},"md":{"width":"246px"},"xs":{"width":"276px"}},"heading":{"xl":{"fontSize":"28px","fontWeight":"500","lineHeight":"35px","color":"rgb(0, 0, 0)","textAlign":"left","marginBottom":"9px"}},"text":{"xl":{"fontSize":"16px","fontWeight":"400","lineHeight":"27.84px","color":"rgb(105, 105, 105)","textAlign":"left"}},"content":{"xl":{"fontSize":"16px","fontWeight":"400","lineHeight":"27.84px","color":"rgb(105, 105, 105)","textAlign":"left"}}}},{"kind":"box","variant":"image-04","heading":"Data Architects","textHtml":"Our data architects are experts in designing, building, and optimizing your data architecture to ensure efficient data flow and storage. With deep experience in cloud data platforms, big data ecosystems, and data integration, they craft scalable architectures that support your business's current and future data needs. Whether you're transitioning to the cloud or building a data lake, our data architects ensure your infrastructure is built to perform.","style":{"xl":{}},"parts":{"wrap":{"xl":{"paddingTop":"50px","paddingRight":"42px","paddingBottom":"56px","paddingLeft":"42px","backgroundColor":"rgb(255, 255, 255)","borderRadius":"5px","boxShadow":"rgba(51, 51, 51, 0.1) 0px 0px 25px 0px","textAlign":"left"}},"image":{"xl":{"width":"486px"},"md":{"width":"246px"},"xs":{"width":"276px"}},"heading":{"xl":{"fontSize":"28px","fontWeight":"500","lineHeight":"35px","color":"rgb(0, 0, 0)","textAlign":"left","marginBottom":"9px"}},"text":{"xl":{"fontSize":"16px","fontWeight":"400","lineHeight":"27.84px","color":"rgb(105, 105, 105)","textAlign":"left"}},"content":{"xl":{"fontSize":