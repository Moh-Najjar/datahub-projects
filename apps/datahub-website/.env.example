# Copy to `.env.local` (or set in the build environment). VITE_ variables are embedded in the
# browser bundle: they are PUBLIC — never put secrets here.

# Base URL of the DataHub HR Admin Portal. The Workspace's "HR Admin" card opens <url>/sso#token=… (prototype single
# sign-in). Development default: http://localhost:3001. A production build without it hides the HR Admin card.
# The portal needs VITE_WORKSPACE_URL pointing back at this site (see its .env.example).
VITE_HR_ADMIN_PORTAL_URL=

# Blogs Admin (/admin/, blog management prototype; staff sign in through the Workspace at /workspace/login/; changes
# are stored only in the browser). Always available in development; set to `true` to include it in a production build
# (without it the Workspace has no Blogs Admin card).
VITE_ENABLE_ADMIN=

# Origin of the DataHub Analytics backend API: blog posts (public site + Blogs Admin) and the Workspace sign-in.
# Public — never a secret. In development the Vite dev server proxies /api to it. Production calls it directly, so the
# site's origin must be allowed by the API's CORS configuration. Without it the blog shows its error state.
VITE_API_URL=https://datahubanalytics-api-fybyhjerfcd8ekfc.westeurope-01.azurewebsites.net

# Base URL of the DataHub Trainee App (apps/datahub-trainee-app). The Workspace's "Trainee App" card opens
# <url>/sso#token=… (same handoff as HR Admin). Development default: http://localhost:3002. A production build
# without it hides the Trainee App card. The app needs VITE_WORKSPACE_URL pointing back at this site.
VITE_TRAINEE_APP_URL=
