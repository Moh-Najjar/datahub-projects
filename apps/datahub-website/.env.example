# Copy to `.env.local` (or set in the build environment). VITE_ variables are embedded in the
# browser bundle: they are PUBLIC — never put secrets here.

# Optional endpoint that receives appointment/contact form submissions as JSON.
# Without it the form says the message was not sent.
VITE_FORM_ENDPOINT=

# Base URL of the DataHub HR Admin Portal; the header's "HR Portal" link opens <url>/login.
# Development default: http://localhost:5174. A production build without it hides the link.
VITE_HR_ADMIN_PORTAL_URL=

# Admin area (/admin/, blog management prototype with temporary mock sign-in; changes are stored only in the
# browser). Always available in development; set to `true` to include it in a production build.
VITE_ENABLE_ADMIN=
