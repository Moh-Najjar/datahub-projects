ineHeight":"51.6px"}}}]},{"kind":"column","width":{"md":12,"lg":5},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"spacer","height":{"xl":{"height":"50px"},"md":{"height":"30px"}}},{"kind":"heading","tag":"h3","text":"مقابل كل دولار يتم إنفاقه على ذكاء الأعمال ، يمكن للشركات أن تتوقع متوسط عائد قدره 13.01 دولارا.","style":{"xl":{"fontSize":"24px","fontWeight":"800","lineHeight":"40.08px","color":"rgb(51, 51, 51)","textAlign":"left","marginBottom":"25px","maxWidth":"400px","paddingLeft":"34px"},"md":{"fontSize":"18px","lineHeight":"30.06px"}}},{"kind":"spacer","height":{"xl":{"height":"100px"},"md":{"height":"30px"}}}]},{"kind":"column","width":{"md":12,"lg":7},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"heading","tag":"div","text":"إن الحجم الهائل للبيانات وتنوعها وسرعتها يجعل من الصعب على الشركات استخراج معلومات قيمة وتحديد الأنماط واتخاذ قرارات مستنيرة. تكافح المؤسسات مع صوامع البيانات وعمليات إعداد التقارير المعقدة وعدم القدرة على الوصول إلى المعلومات في الوقت الفعلي. وهذا يخلق حاجة ملحة لحلول ذكاء الأعمال التي يمكنها دمج البيانات بسلاسة من مصادر مختلفة ، وتوفير تصورات بديهية ، وتقديم رؤى قابلة للتنفيذ. تمكن هذه الحلول المؤسسات من الحصول على رؤية شاملة لعملياتها وتحسين الأداء والبقاء في صدارة المنافسة.","style":{"xl":{"fontSize":"17px","fontWeight":"400","lineHeight":"28.39px","color":"rgb(105, 105, 105)","textAlign":"left","maxWidth":"100%"}}},{"kind":"spacer","height":{"xl":{"height":"50px"},"md":{"height":"30px"}}},{"kind":"heading","tag":"div","text":"في Datahub Analytics ، يتفوق فريقنا من المهنيين المهرة في ذكاء الأعمال. من خلال الخبرة في تكامل البيانات والتحليلات المتقدمة وإعداد التقارير البديهية ، نقدم حلولا مخصصة تعالج التحديات الفريدة التي يواجهها عملاؤنا. تشمل قدراتنا مستودع البيانات ، وتصور البيانات ، ولوحات المعلومات التفاعلية ، وتحليلات الخدمة الذاتية ، وتمكين المستخدمين من استكشاف البيانات ، وإنشاء تقارير ذات مغزى ، واكتساب رؤى قابلة للتنفيذ. نحن نستفيد من التقنيات المتطورة وأفضل الممارسات الصناعية لضمان أن حلول ذكاء الأعمال لدينا تمكن المؤسسات من اتخاذ قرارات تعتمد على البيانات ، ودفع النمو ، وتحقيق ميزة تنافسية.","style":{"xl":{"fontSize":"17px","fontWeight":"400","lineHeight":"28.39px","color":"rgb(105, 105, 105)","textAlign":"left","maxWidth":"100%"}}},{"kind":"spacer","height":{"xl":{"height":"32px"}}},{"kind":"heading","tag":"h4","text":"كن شريكا مع داتا هب انالتكس للحصول على حلول ذكاء الأعمال الشاملة التي تطلق العنان للإمكانات الكاملة لأصول البيانات الخاصة بك.","style":{"xl":{"fontSize":"20px","fontWeight":"400","lineHeight":"28px","color":"rgb(0, 68, 147)","textAlign":"left","maxWidth":"100%"}}}]}]},{"kind":"row","id":"tm-row-6af3178541591","fullWidth":true,"stretchContent":false,"style":{"xl":{"backgroundColor":"rgb(248, 248, 248)"}},"separators":[{"position":"bottom","viewBox":"0 0 2.23333 0.1","paths":["M2.23281 0.0372047c0,0 -0.0261929,-0.000389764 -0.0423307,-0.00584252 0,0 -0.0356181,0.0278268 -0.0865354,0.0212205 0,0 -0.0347835,-0.00524803 -0.0579094,-0.0283701 0,0 -0.0334252,0.0112677 -0.0773425,-0.00116929 0,0 -0.0590787,0.0524724 -0.141472,0.000779528 0,0 -0.0288189,0.0189291 -0.0762362,0.0111535 -0.00458268,0.0141024 -0.0150945,0.040122 -0.0656811,0.0432598 -0.0505866,0.0031378 -0.076126,-0.0226614 -0.0808425,-0.0308228 -0.00806299,0.000854331 -0.0819961,0.0186969 -0.111488,-0.022815 -0.0076378,0.0114843 -0.059185,0.0252598 -0.083563,-0.000385827 -0.0295945,0.0508661 -0.111996,0.0664843 -0.153752,0.019 -0.0179843,0.00227559 -0.0571181,0.00573622 -0.0732795,-0.0152953 -0.027748,0.0419646 -0.110602,0.0366654 -0.138701,0.00688189 0,0 -0.0771732,0.0395709 -0.116598,-0.0147677 0,0 -0.0497598,0.02 -0.0773346,-0.00166929 0,0 -0.0479646,0.0302756 -0.0998937,0.00944094 0,0 -0.0252638,0.0107874 -0.0839488,0.00884646 0,0 -0.046252,0.000775591 -0.0734567,-0.0237087 0,0 -0.046252,0.0101024 -0.0769567,-0.00116929 0,0 -0.045082