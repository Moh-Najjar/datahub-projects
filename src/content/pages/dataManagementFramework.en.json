 and methodologies to ensure data integrity, improve data accessibility, and enhance data security throughout the data lifecycle. Our professionals are equipped with extensive knowledge and experience, enabling them to streamline data operations, establish effective data governance practices, and promote a culture of data-driven decision-making.","style":{"xl":{"fontSize":"17px","fontWeight":"400","lineHeight":"28.39px","color":"rgb(105, 105, 105)","textAlign":"left","maxWidth":"100%"}}},{"kind":"spacer","height":{"xl":{"height":"32px"}}},{"kind":"heading","tag":"h4","text":"Partner with Datahub to improve compliance and mitigate risk.","style":{"xl":{"fontSize":"20px","fontWeight":"400","lineHeight":"28px","color":"rgb(0, 68, 147)","textAlign":"left","maxWidth":"100%"}}}]}]},{"kind":"row","id":"tm-row-6af318d922164","fullWidth":true,"stretchContent":false,"style":{"xl":{"backgroundColor":"rgb(255, 255, 255)"}},"separators":[],"align":"middle","columns":[{"kind":"column","width":{"md":12},"style":{"xl":{"paddingRight":"15px","paddingLeft":"15px"},"xs":{"paddingRight":"initial","paddingLeft":"initial"}},"children":[{"kind":"spacer","height":{"xl":{"height":"100px"}}}]}]},{"kind":"row","id":"tm-row-6af318d9225c9","fullWidth":true,"stretchContent":false,"style":{"xl":{"backgroundColor":"rgb(255, 255, 255)"}},"separators":[],"align":"middle","columns":[{"kind":"column","width":{"md":3},"style":{"xl":{"paddingRight":"15px","paddingLeft":"15px"},"xs":{"paddingRight":"initial","paddingLeft":"initial"}},"children":[]},{"kind":"column","width":{"md":6},"style":{"xl":{"paddingRight":"15px","paddingLeft":"15px"},"xs":{"paddingRight":"initial","paddingLeft":"initial"}},"children":[{"kind":"heading","tag":"h2","text":["DAMA",{"mark":" Core"}],"style":{"xl":{"fontSize":"48px","fontWeight":"400","lineHeight":"56.16px","color":"rgb(51, 51, 51)","textAlign":"center","maxWidth":"930px"},"md":{"fontSize":"36px","lineHeight":"42.12px"}},"markStyle":{"xl":{"fontSize":"48px","fontWeight"