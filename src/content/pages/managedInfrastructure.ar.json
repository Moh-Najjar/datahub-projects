play":"inline"},"md":{"fontSize":"40px","lineHeight":"51.6px"}}}]},{"kind":"column","width":{"md":12,"lg":5},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"spacer","height":{"xl":{"height":"50px"},"md":{"height":"30px"}}},{"kind":"heading","tag":"h3","text":"باستخدام حلول البنية التحتية المدارة، يمكن للشركات التوفير في التكاليف بنسبة تصل إلى 30٪ وتقليل الحوادث الأمنية بنسبة تصل إلى 80٪ مقارنة بالإدارة الداخلية.","style":{"xl":{"fontSize":"24px","fontWeight":"800","lineHeight":"40.08px","color":"rgb(51, 51, 51)","textAlign":"left","marginBottom":"25px","maxWidth":"400px","paddingLeft":"34px"},"md":{"fontSize":"18px","lineHeight":"30.06px"}}},{"kind":"spacer","height":{"xl":{"height":"100px"},"md":{"height":"30px"}}}]},{"kind":"column","width":{"md":12,"lg":7},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"heading","tag":"div","text":"في مشهد الأعمال السريع والمتنافس، تواجه المؤسسات تحديات متزايدة في إدارة البنية التحتية لتكنولوجيا المعلومات الخاصة بها بشكل فعال. لقد أصبحت التعقيدات المرتبطة بالحفاظ على مجموعة متنوعة من التقنيات، وضمان التوفر العالي، والبقاء على اطلاع دائم على التهديدات الأمنية السريعة التطور تشكل عبء كبير. بدون إدارة قوية استباقية، تتعرض الشركات لفشل في الكفاءة التشغيلية، وزيادة في وقت التوقف عن العمل، وتهديدات على أمن البيانات. تحتاج المؤسسات إلى حلاً موثوقًا وقابلاً للتطوير يمكنه التعامل مع هذه التحديات بينما يتيح لهم امكانية التركيز على استراتيجيات العمل الأساسية والابتكار.","style":{"xl":{"fontSize":"17px","fontWeight":"400","lineHeight":"28.39px","color":"rgb(105, 105, 105)","textAlign":"left","maxWidth":"100%"}}},{"kind":"spacer","height":{"xl":{"height":"50px"},"md":{"height":"30px"}}},{"kind":"heading","tag":"div","text":"تقف حلول البنية التحتية المدارة لدى داتاهب في مقدمة الإدارة الاستباقية، حيث توفر دعمًا شاملاً لعملائنا وإرشادات من الخبراء. بفضل فريق من المحترفين من ذوي الخبرة، نستخدم أدوات مراقبة متطورة، وأفضل الممارسات الصناعية، ونهجًا يركز على العميل لتقديم قدرات لا مثيل لها. من تكوين البنية التحتية وتحسينها إلى المراقبة في الوقت الفعلي، وحل المشكلات، وفرض الأمان، تضمن حلول البنية التحتية المدارة لدينا أعلى مستوى من الثقة والأداء وسلامة البيانات. ومن خلال الاستفادة من خبرتنا، يمكن للمؤسسات الاطمئنان لأن أصول تكنولوجيا المعلومات المهمة لديهم في أيدي قادرة، حيث نعمل باستمرار على ضبط وتحسين بنيتهم التحتية لتلبية المطالبات المتطورة.","style":{"xl":{"fontSize":"17px","fontWeight":"400","lineHeight":"28.39px","color":"rgb(105, 105, 105)","textAlign":"left","maxWidth":"100%"}}},{"kind":"spacer","height":{"xl":{"height":"32px"}}},{"kind":"heading","tag":"h4","text":"انضم إلى داتاهب لتحقيق كفاءة تشغيلية وفعالية تكلفة.","style":{"xl":{"fontSize":"20px","fontWeight":"400","lineHeight":"28px","color":"rgb(0, 68, 147)","textAlign":"left","maxWidth":"100%"}}}]}]},{"kind":"row","id":"tm-row-6af317d3f0393","fullWidth":true,"stretchContent":false,"style":{"xl":{"backgroundColor":"rgb(248, 248, 248)"}},"separators":[{"position":"bottom","viewBox":"0 0 2.23333 0.1","paths":["M2.23281 0.0372047c0,0 -0.0261929,-0.000389764 -0.0423307,-0.00584252 0,0 -0.0356181,0.0278268 -0.0865354,0.0212205 0,0 -0.0347835,-0.00524803 -0.0579094,-0.0283701 0,0 -0.0334252,0.0112677 -0.0773425,-0.00116929 0,0 -0.0590787,0.0524724 -0.141472,0.000779528 0,0 -0.0288189,0.0189291 -0.0762362,0.0111535 -0.00458268,0.0141024 -0.0150945,0.040122 -0.0656811,0.0432598 -0.0505866,0.0031378 -0.076126,-0.0226614 -0.0808425,-0.0308228 -0.00806299,0.000854331 -0.0819961,0.0186969 -0.111488,-0.022815 -0.0076378,0.0114843 -0.059185,0.0252598 -0.083563,-0.000385827 -0.0295945,0.0508661 -0.111996,0.0664843 -0.153752,0.019 -0.0179843,0.00227559 -0.0571181,0.00573622 -0.0732795,-0.0152953 -0.027748,0.0419646 -0.110602,0.0366654 -0.138701,0.00688189 0,0 -0.0771732,0.0395709 -0.116598,-0.0147677 0,0 -0.0497598,0.02 -0.0773346,-0.00166929 0,0 -0.0479646,0.0302756 -0.0998937,0.00944094 0,0 -0.0252638,0.0107874 -0.0839488,0.00884646 0,0 -0.046252,0.000775591 -0.0734567,-0.0237087 0,0 -0.046252,0.0101024 -0.0769567,-0.00116929 0,0 -0.0450827,0.0314843 -0.118543,0.0108858 0,0 -0.0715118,0.0609803 -0.144579,0.00423228 0,0 -0.0385787,0.00770079 -0.0646299,0.000102362 0,0 -0.0387559,0.0432205 -0.125039,0.0206811 0,0 -0.0324409,0.0181024 -0.0621457,0.0111063l-3.93701e-005 0.0412205 2.2323 0 0 -0.0627953z"],"color":"rgb(255, 255, 255)","height":{"xl":{"height":"100px"}}}],"columns":[{"kind":"column","width":{"md":12},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"spacer","height":{"xl":{"height":"100px"},"md":{"height":"50px"}}},{"kind":"heading","tag":"h2","text":[{"mark":"مجموعة حلول البنية التحتية المدارة "}],"style":{"xl":{"fontSize":"48px","fontWeight":"400","lineHeight":"56.16px","color":"rgb(51, 51, 51)","textAlign":"center","maxWidth":"930px"},"md":{"fontSize":"36px","lineHeight":"42.12px"}},"markStyle":{"xl":{"fontSize":"48px","fontWeight":"400","lineHeight":"56.16px","color":"rgb(0, 68, 147)","textAlign":"center","display":"inline"},"md":{"fontSize":"36px","lineHeight":"42.12px"}}},{"kind":"spacer","height":{"xl":{"height":"20px"},"md":{"height":"10px"}}},{"kind":"heading","tag":"h4","text":"مدفوعة بخبرة حلول المؤسسات بقطاعات مختلفة","style":{"xl":{"fontSize":"17px","fontWeight":"400","lineHeight":"23.8px","color":"rgb(112, 112, 112)","textTransform":"uppercase","textAlign":"center","maxWidth":"100%"}}},{"kind":"spacer","height":{"xl":{"height":"100px"},"md":{"height":"50px"}}},{"kind":"grid","columns":{"xl":{"gridTemplateColumns":"2","columnGap":"30px","rowGap":"30px"},"xs":{"gridTemplateColumns":"1"}},"gap":{"xl":{"gridTemplateColumns":"2","columnGap":"30px","rowGap":"30px"},"xs":{"gridTemplateColumns":"1"}},"children":[{"kind":"box","variant":"image-04","heading":"أتمتة للبنية التحتية","textHtml":"تقدم حلول الأتمتة للبنية التحتية من داتاهب نهجا متطورا ومصمم خصيصا لتبسيط وتحسين إدارة البنية التحتية لتكنولوجيا المعلومات لعملائنا. باستخدام الأتمتة الاستباقية والذكية، يقوم فريقنا المتخصص باستخدام أدوات حديثة وأفضل الممارسات لأتمتة المهام الروتينية، وإدارة التكوين، وتوفير الموارد. يضمن ذلك عمليات متسقة وقابلة للتكرار، ويقلل من الأخطاء اليدوية، ويعزز كفاءة التشغيل. من خلال الاستفادة من مبادئ البنية التحتية كرمز أو شيفرة (IaC)، فإننا نمكن العملاء من تحديد ونسخ تكوينات البنية التحتية الخاصة بهم بسهولة، مما يؤدي إلى تسريع نشر التطبيقات وتوسيع نطاقها بسهولة.\n<p>تعمل حلول أتمتة البنية التحتية لدينا على تمكين المؤسسات من زيادة استخدام الموارد، وتحقيق توفير في التكاليف، وتحرير الموارد التكنولوجية القيمة للتركيز على المبادرات الاستراتيجية، مما يعزز الابتكار ويدفع بالنمو المستدام في مشهد الأعمال الديناميكي اليوم.</p>","style":{"xl":{}},"parts":{"wrap":{"xl":{"paddingTop":"50px","paddingBottom":"56px","backgroundColor":"rgb(255, 255, 255)","borderRadius":"5px","boxShadow":"rgba(51, 51, 51, 0.1) 0px 0px 25px 0px","textAlign":"left","paddingLeft":"42px","paddingRight":"42px"}},"image":{"xl":{"width":"486px"},"md":{"width":"246px"},"xs":{"width":"276px"}},"heading":{"xl":{"fontSize":"28px","fontWeight":"500","lineHeight":"35px","color":"rgb(0, 0, 0)","textAlign":"left","marginBottom":"9px"}},"text":{"xl":{"fontSize":"16px","fontWeight":"400","lineHeight":"27.84px","color":"rgb(105, 105, 105)","textAlign":"left"}},"content":{"xl":{"fontSize":"16px","fontWeight":"400","lineHeight":"27.84px","color":"rgb(105, 105, 105)","textAlign":"left"}}}},{"kind":"box","variant":"image-04","heading":"التوسع التلقائي وتحسين الموارد","textHtml":"توفر حلول التوسع التلقائي وتحسين الموارد لدى داتاهب أسلوبا ديناميكيًا وفعالًا لإدارة موارد السحابة بفعالية. باستخدام أدوات الأتمتة المتقدمة وأدوات المراقبة، نقوم بتمكين المؤسسات من زيادة حجم الموارد أو تقليلها حسب الطلب وفي الوقت الفعلي، مما يضمن الأداء الأمثل والكفاءة من حيث التكلفة. يقوم فريقنا المتخصص بتنفيذ خوارزميات ذكية لتحليل أنماط عبء العمل واستخدام الموارد، مما يتيح تحديد فرص التحسين واختيار البنية التحتية ذات الحجم الصحيح. ويؤدي هذا إلى تحقيق توفير كبير في التكاليف، حيث يدفع العملاء فقط مقابل الموارد التي يحتاجون إليها، مما يقلل من الفاقد ويعزز الكفاءة العامة.\n<p>بفضل الحلول التي نقدمها للتوسع التلقائي وتحسين الموارد، يمكن للمؤسسات التعامل بثقة مع أعباء العمل غير المتوقعة، مما يضمن العمل المستمر ويعزز العائد على استثمارها في السحابة.</p>","style":{"xl":{}},"parts":{"wrap":{"xl":{"paddingTop":"50px","paddingBottom":"56px","backgroundColor":"rgb(255, 255, 255)","borderRadius":"5px","boxShadow":"rgba(51, 51, 51, 0.1) 0px 0px 25px 0px","textAlign":"left","paddingLeft":"42px","paddingRight":"42px"}},"image":{"xl":{"width":"486px"},"md":{"width":"246px"},"xs":{"width":"276px"}},"heading":{"xl":{"fontSize":"28px","fontWeight":"500","lineHeight":"35px","color":"rgb(0, 0, 0)","textAlign":"left","marginBottom":"9px"}},"text":{"xl":{"fontSize":"16px","fontWeight":"400","lineHeight":"27.84px","color":"rgb(105, 105, 105)","textAlign":"left"}},"content":{"xl":{"fontSize":"16px","fontWeight":"400","lineHeight":"27.84px","color":"rgb(105, 105, 105)","textAlign":"left"}}}},{"kind":"box","variant":"image-04","heading":"المراقبة والتنبيه","textHtml":"تقدم حلول المراقبة والتنبيه من داتاهب نهجًا قويًا وشاملًا لضمان استمرارية الأداء وصحة أداء البنية التحتية لتكنولوجيا المعلومات لعملائنا. من خلال مجموعة من أدوات المراقبة المتطورة والممارسات الاستباقية، نقدم معلومات في الوقت الحقيقي حول مقاييس النظام وأداء التطبيقات واستخدام الموارد. تقوم آليات التنبيه المصممة خصيصًا بإشعار العملاء على الفور بأي مشاكل محتملة أو انحرافات عن الحدود المحددة مسبقًا، مما يسمح باتخاذ إجراء سريع وحل المشكلات بشكل استباقي. وبفضل لوحات المعلومات القابلة للتخصيص والتقارير المفصلة، تحصل المؤسسات على رؤية واضحة لأداء البنية التحتية الخاصة بها، مما يمكّنها من اتخاذ القرارات المستندة إلى البيانات وتحسين تخصيص الموارد.\n<p>تعمل حلول المراقبة والتنبيه لدينا على تمكين العملاء من الحفاظ على التوفر العالي، واكتشاف الحالات الشاذة، وتحسين الكفاءة التشغيلية، مما يؤدي إلى تعزيز بيئتهم التكنولوجية وتقديم تجربة مستخدم استثنائية.</p>","style":{"xl":{}},"parts":{"wrap":{"xl":{"paddingTop":"50px","paddingBottom":"56px","backgroundColor":"rgb(255, 255, 255)","borderRadius":"5px","boxShadow":"rgba(51, 51, 51, 0.1) 0px 0px 25px 0px","textAlign":"left","paddingLeft":"42px","paddingRight":"42px"}},"image":{"xl":{"width":"486px"},"md":{"width":"246px"},"xs":{"width":"276px"}},"heading":{"xl":{"fontSize":"28px","fontWeight":"500","lineHeight":"35px","color":"rgb(0, 0, 0)","textAlign":"left","marginBottom":"9px"}},"text":{"xl":{"fontSize":"16px","fontWeight":"400","lineHeight":"27.84px","color":"rgb(105, 105, 105)","textAlign":"left"}},"content":{"xl":{"fontSize":"16px","fontWeight":"400","lineHeight":"27.84px","color":"rgb(105, 105, 105)","textAlign":"left"}}}},{"kind":"box","variant":"image-04","heading":"النسخ الاحتياطي والتعافي من الكوارث","textHtml":"توفر حلول النسخ الاحتياطي والتعافي من الكوارث لدى داتاهب إطارًا قويًا وموثوقًا لحماية البيانات الهامة لعملائنا وضمان استمرارية العمل في مواجهة الأحداث غير المتوقعة. باستخدام أحدث تقنيات النسخ الاحتياطي الحديثة، نقوم بإنشاء نسخ متكررة من البيانات عبر مواقع آمنة ومتنوعة جغرافيًا، مما يقلل من مخاطر فقدان البيانات بسبب فشل الأجهزة، أو الأخطاء البشرية، أو التهديدات السيبرانية. تم تصميم استراتيجيات التعافي من الكوارث لدينا بدقة، بما في ذلك آليات التحويل التلقائي وإجراءات الاسترداد السريع لتقليل وقت التوقف عن العمل والحفاظ على العمليات السلسة أثناء الحوادث التخريبية.\n<p>من خلال الاختبار والتحقق المنتظمين، نضمن فعالية خطط النسخ الاحتياطي والتعافي من الكوارث لدينا، مما يمكّن المؤسسات من التنقل بثقة في المواقف الصعبة والحفاظ على أصول بياناتهم الحيوية، حتى في أقسى السيناريوهات.</p>","style":{"xl":{}},"parts":{"wrap":{"xl":{"paddingTop":"50px","paddingBottom":"56px","backgroundColor":"rgb(255, 255, 255)","borderRadius":"5px","boxShadow":"rgba(51, 51, 51, 0.1) 0px 0px 25px 0px","textAlign":"left","paddingLeft":"42px","paddingRight":"42px"}},"image":{"xl":{"width":"486px"},"md":{"width":"246px"},"xs":{"width":"276px"}},"heading":{"xl":{"fontSize":"28px","f