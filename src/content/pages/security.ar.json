 أي وصول غير مصرح به أو خروقات للبيانات على الفور.\n<p>من خلال خدماتنا المتخصصة في ادارة البيانات، تحصل المؤسسات على رؤية وتحكم أكبر ببياناتها، مما يعزز ثقافة ادارة البيانات و<br>\nأمن البيانات والامتثال بشكل العام.</p>","button":{"label":"تعرف على المزيد","href":"/services/data-governance/","variant":"flat","icon":null,"iconPosition":"right","style":{"xl":{"fontSize":"14px","fontWeight":"500","lineHeight":"56px","color":"rgb(0, 68, 147)","borderTop":"1px solid rgb(238, 238, 238)","height":"56px"}},"newTab":false},"style":{"xl":{}},"parts":{"wrap":{"xl":{"backgroundColor":"rgb(255, 255, 255)","borderRadius":"5px","boxShadow":"rgba(51, 51, 51, 0.1) 0px 0px 40px 0px","textAlign":"left"}},"text":{"xl":{"fontSize":"17px","fontWeight":"400","lineHeight":"29.58px","color":"rgb(105, 105, 105)","textAlign":"left","marginTop":"12px"}},"content":{"xl":{"fontSize":"17px","fontWeight":"400","lineHeight":"29.58px","color":"rgb(105, 105, 105)","textAlign":"left","paddingTop":"32px","paddingBottom":"88px","paddingLeft":"35px","paddingRight":"35px"}},"btnText":{"xl":{"fontSize":"14px","fontWeight":"500","lineHeight":"56px","color":"rgb(0, 68, 147)","textAlign":"center"}}}}]}]},{"kind":"spacer","height":{"xl":{"height":"50px"}}}]}]},{"kind":"row","id":"tm-row-6af3175555e00","fullWidth":true,"stretchContent":false,"style":{"xl":{"paddingTop":"50px","paddingBottom":"50px"}},"separators":[],"columns":[{"kind":"column","width":{"md":12},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"heading","tag":"h2","text":[{"mark":"فوائد خدمات أمن داتاهب"}],"style":{"xl":{"fontSize":"48px","fontWeight":"400","lineHeight":"56.16px","color":"rgb(51, 51, 51)","textAlign":"center","maxWidth":"930px"},"md":{"fontSize":"36px","lineHeight":"42.12px"}},"markStyle":{"xl":{"fontSize":"48px","fontWeight":"400","lineHeight":"56.16px","color":"rgb(0, 68, 147)","textAlign":"center","display":"inline"},"md":{"fontSize":"36px"