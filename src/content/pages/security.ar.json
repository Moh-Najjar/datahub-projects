,"display":"inline-block","paddingLeft":"36px","paddingRight":"36px"}}}}]},{"kind":"column","width":{"md":8},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"box","variant":"large-image-03","href":"/services/cybersecurity-assessments/","heading":"","textHtml":"تم تصميم خدمات تقييمات أمن المعلومات لتوفير تقييم شامل ومفصل لتدابير الأمن الخاصة بالمؤسسات. يقوم فريقنا من خبراء أمن المعلومات من ذوي الخبرة بإجراء تقييمات متعمقة، يتم خلالها فحص جميع جوانب الأمن في المؤسسة. بدءا من تقييم مدى نضج مركز العمليات الأمنية (SOC) وصولا إلى قياس قدرتهم على الاستجابة للحوادث وتقييم مرونة التكنولوجيا والبنية التحتية، فإن جهودنا لا تتوقف. نحن نقوم بتحديد الثغرات المحتملة في بروتوكولات الأمن، والقطاعات التي يمكن تحسينها، مما يوفر للمؤسسات معلومات قيمة وتوصيات قابلة للتنفيذ.\n<p>بالاعتماد على هذه المعرفة، يمكن للشركات اتخاذ قرارات مستنيرة، وتحديد أولويات الاستثمار في الأمن، وتعزيز دفاعاتها ضد التهديدات السيبرانية المتطورة، مما يعزز في النهاية مرونتها في مجال أمن المعلومات.</p>","button":{"label":"تعرف على المزيد","href":"/services/cybersecurity-assessments/","variant":"flat","icon":null,"iconPosition":"right","style":{"xl":{"fontSize":"14px","fontWeight":"500","lineHeight":"56px","color":"rgb(0, 68, 147)","borderTop":"1px solid rgb(238, 238, 238)","height":"56px"}},"newTab":false},"style":{"xl":{}},"parts":{"wrap":{"xl":{"backgroundColor":"rgb(255, 255, 255)","borderRadius":"5px","boxShadow":"rgba(51, 51, 51, 0.1) 0px 0px 40px 0px","textAlign":"left"}},"text":{"xl":{"fontSize":"17px","fontWeight":"400","lineHeight":"29.58px","color":"rgb(105, 105, 105)","textAlign":"left","marginTop":"12px"}},"content":{"xl":{"fontSize":"17px","fontWeight":"400","lineHeight":"29.58px","color":"rgb(105, 105, 105)","textAlign":"left","paddingTop":"32px","paddingBottom":"88px","paddingLeft":"35px","paddingRight":"35px"}},"btnText":{"xl":{"fontSize":"14px","fontWeight":"500","lineHeight":"56px","color":"rgb(0, 68, 147)","textAlign":"center"}}}}]}]},{"kind":"spacer","height":{"xl":{"height":"32px"}}},{"kind":"row","id":"tm-row-inner-6af3175552565","fullWidth":false,"stretchContent":false,"style":{"xl":{}},"separators":[],"align":"middle","columns":[{"kind":"column","width":{"md":4},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"box","variant":"large-image-01","href":"/services/governance-risk-and-compliance/","image":{"src":"/assets/uploads/2023/08/dh-grc-2-330x330.jpg","alt":"Compliance Virtual Diagram for regulations, law, standards, requirements and audit.co working team meeting concept,businessman using smart phone and digital tablet and laptop computer in modern office","width":330,"height":330},"heading":"الحوكمة والمخاطر والامتثال","button":{"label":"تعرف على المزيد","href":"/services/governance-risk-and-compliance/","variant":"flat","icon":null,"iconPosition":"right","style":{"xl":{"fontSize":"14px","fontWeight":"400","lineHeight":"56px","color":"rgb(8, 106, 216)","backgroundColor":"rgb(255, 255, 255)","borderRadius":"5px","height":"56px","paddingLeft":"36px","paddingRight":"36px"}},"newTab":false},"style":{"xl":{}},"parts":{"wrap":{"xl":{"textAlign":"center"}},"image":{"xl":{"width":"370px"},"md":{"width":"210px"},"xs":{"width":"360px"}},"heading":{"xl":{"fontSize":"24px","fontWeight":"500","lineHeight":"36px","color":"rgb(255, 255, 255)","textAlign":"center"}},"content":{"xl":{"fontSize":"15px","fontWeight":"400","lineHeight":"26.1px","color":"rgb(105, 105, 105)","textAlign":"center"}},"btnText":{"xl":{"fontSize":"14px","fontWeight":"400","lineHeight":"56px","color":"rgb(8, 106, 216)","textAlign":"center","backgroundColor":"rgb(255, 255, 255)","display":"inline-block","paddingLeft":"36px","paddingRight":"36px"}}}}]},{"kind":"column","width":{"md":8},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"box","variant":"large-image-03","href":"/services/governance-risk-and-compliance/","heading":"","textHtml":"تهدف خدماتنا في الحوكمة والمخاطر والامتثال إلى تمكين المؤسسات بأطر قوية واستراتيجيات لإدارة تحديات أمن المعلومات بفعالية. من خلال الاستفادة من المعايير الرائدة في الصناعة مثل ISO 27001:2022 وإطار أمن المعلومات من المعهد الوطني للمعايير والتكنولوجيا (NIST)، نقدم تقييمات وإرشادات مخصصة لمواءمة عمل الشركة مع أفضل الممارسات في الحوكمة وإدارة المخاطر والامتثال. يساعد خبراؤنا من ذوو الخبرة في تنفيذ الضوابط والتدابير اللازمة، مما يساعد المؤسسات في تحديد الحوادث السيبرانية، واحتواءها، وكشفها، والاستجابة لها ، والتعافي منها.\n<p>من خلال خدماتنا المتخصصة، تكتسب الشركات أساسا قويا لتخفيف المخاطر، والامتثال للمتطلبات التنظيمية، ومواجهة تحديات أمن المعلومات بشكل استباقي، مع غرس ثقافة الوعي الأمني والمرونة في جميع عملياتها.</p>","button":{"label":"تعرف على المزيد","href":"/services/governance-risk-and-compliance/","variant":"flat","icon":null,"iconPosition":"right","style":{"xl":{"fontSize":"14px","fontWeight":"500","lineHeight":"56px","color":"rgb(0, 68, 147)","borderTop":"1px solid rgb(238, 238, 238)","height":"56px"}},"newTab":false},"style":{"xl":{}},"parts":{"wrap":{"xl":{"backgroundColor":"rgb(255, 255, 255)","borderRadius":"5px","boxShadow":"rgba(51, 51, 51, 0.1) 0px 0px 40px 0px","textAlign":"left"}},"text":{"xl":{"fontSize":"17px","fontWeight":"400","lineHeight":"29.58px","color":"rgb(105, 105, 105)","textAlign":"left","marginTop":"12px"}},"content":{"xl":{"fontSize":"17px","fontWeight":"400","lineHeight":"29.58px","color":"rgb(105, 105, 105)","textAlign":"left","paddingTop":"32px","paddingBottom":"88px","paddingLeft":"35px","paddingRight":"35px"}},"btnText":{"xl":{"fontSize":"14px","fontWeight":"500","lineHeight":"56px","color":"rgb(0, 68, 147)","textAlign":"center"}}}}]}]},{"kind":"spacer","height":{"xl":{"height":"32px"}}},{"kind":"row","id":"tm-row-inner-6af31755539f7","fullWidth":false,"stretchContent":false,"style":{"xl":{}},"separators":[],"align":"middle","columns":[{"kind":"column","width":{"md":4},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"box","variant":"large-image-01","href":"/services/data-management-framework-dama/","image":{"src":"/assets/uploads/2023/08/dh-dama-2-330x330.jpg","alt":"dh-dama-2","width":330,"height":330},"heading":"إطار إدارة البيانات","button":{"label":"تعرف على المزيد","href":"/services/data-management-framework-dama/","variant":"flat","icon":null,"iconPosition":"right","style":{"xl":{"fontSize":"14px","fontWeight":"400","lineHeight":"56px","color":"rgb(8, 106, 216)","backgroundColor":"rgb(255, 255, 255)","borderRadius":"5px","height":"56px","paddingLeft":"36px","paddingRight":"36px"}},"newTab":false},"style":{"xl":{}},"parts":{"wrap":{"xl":{"textAlign":"center"}},"image":{"xl":{"width":"370px"},"md":{"width":"210px"},"xs":{"width":"360px"}},"heading":{"xl":{"fontSize":"24px","fontWeight":"500","lineHeight":"36px","color":"rgb(255, 255, 255)","textAlign":"center"}},"content":{"xl":{"fontSize":"15px","fontWeight":"400","lineHeight":"26.1px","color":"rgb(105, 105, 105)","textAlign":"center"}},"btnText":{"xl":{"fontSize":"14px","fontWeight":"400","lineHeight":"56px","color":"rgb(8, 106, 216)","textAlign":"center","backgroundColor":"rgb(255, 255, 255)","display":"inline-block","paddingLeft":"36px","paddingRight":"36px"}}}}]},{"kind":"column","width":{"md":8},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"box","variant":"large-image-03","href":"/services/data-management-framework-dama/","heading":"","textHtml":"تم تصميم خدمات إطار إدارة البيانات لتمكين المؤسسات من خلال تقديم حلول شاملة ومصممة خصيصا لإدارة البيانات استنادًا إلى إطار عمل إدارة البيانات (DMBOK). بالاستناد إلى فريق من المحترفين من ذوي الخبرة في إدارة البيانات، نساعد الشركات في تنفيذ إدارة بيانات قوية، وإدارة جودة البيانات، وهندسة البيانات، وممارسات أمن البيانات. من خلال استغلال ممارسات إطار إدارة البيانات الأفضل، فإننا نساعد المؤسسات على تحديد سياسات البيانات والمعايير والعمليات التي تتماشى مع احتياجاتها الفريدة وتتوافق مع لوائح الصناعة. تتيح لكم خدماتنا المتخصصة في إطار إدارة البيانات فرصة الحصول على أقصى قيمة من أصول البيانات الخاصة بكم، مما يضمن سلامة البيانات، وإمكانية الوصول إليها، وأمنها.\n<p>بدءا من تحليل البيانات وتنقيتها وصولا إلى إدارة البيانات الوصفية وتسلسل البيانات، تغطي خدماتنا كامل دورة حياة إدارة البيانات، مما يعزز الثقافة القائمة على البيانات ويدعم اتخاذ القرارات الذكية لتحقيق النمو المستدام والنجاح.</p>","button":{"label":"تعرف على المزيد","href":"/services/data-management-framework-dama/","variant":"flat","icon":null,"iconPosition":"right","style":{"xl":{"fontSize":"14px","fontWeight":"500","lineHeight":"56px","color":"rgb(0, 68, 147)","borderTop":"1px solid rgb(238, 238, 238)","height":"56px"}},"newTab":false},"style":{"xl":{}},"parts":{"wrap":{"xl":{"backgroundColor":"rgb(255, 255, 255)","borderRadius":"5px","boxShadow":"rgba(51, 51, 51, 0.1) 0px 0px 40px 0px","textAlign":"left"}},"text":{"xl":{"fontSize":"17px","fontWeight":"400","lineHeight":"29.58px","color":"rgb(105, 105, 105)","textAlign":"left","marginTop":"12px"}},"content":{"xl":{"fontSize":"17px","fontWeight":"400","lineHeight":"29.58px","color":"rgb(105, 105, 105)","textAlign":"left","paddingTop":"32px","paddingBottom":"88px","paddingLeft":"35px","paddingRight":"35px"}},"btnText":{"xl":{"fontSize":"14px","fontWeight":"500","lineHeight":"56px","color":"rgb(0, 68, 147)","textAlign":"center"}}}}]}]},{"kind":"spacer","height":{"xl":{"height":"32px"}}},{"kind":"row","id":"tm-row-inner-6af3175554b67","fullWidth":false,"stretchContent":false,"style":{"xl":{}},"separators":[],"align":"middle","columns":[{"kind":"column","width":{"md":4},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"box","variant":"large-image-01","href":"/services/data-governance/","imag