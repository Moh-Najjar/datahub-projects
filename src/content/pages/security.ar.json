(105, 105, 105)","textAlign":"left","maxWidth":"100%"}}},{"kind":"spacer","height":{"xl":{"height":"50px"},"md":{"height":"30px"}}},{"kind":"heading","tag":"div","text":"يقود خدمات أمن داتاهب فريق من المحترفين من ذوي الخبرة الواسعة في مجال أمن البيانات والبنية التحتية. من خلال الاستفادة من أحدث التقنيات وأفضل الممارسات الصناعية، نقدم حلولًا مخصصة لتعزيز البنية التحتية لتكنولوجيا المعلومات، وتأمين مستودعات البيانات، وتعزيز المرونة يشكل عام. نهجنا الشامل يتضمن تشفيرا قويا للبيانات، وكشف مبكر عن التهديدات، ومراقبة الشبكة، وإجراءات التحكم في الوصول للحماية من التهديدات السيبرانية من جميع الزوايا. بدءا من تقييم المخاطر وإدارة الثغرات ونقاط الضعف وحتى التخطيط للتعافي من الكوارث والاستجابة للحوادث، توفر قدراتنا راحة البال للمؤسسات.","style":{"xl":{"fontSize":"17px","fontWeight":"400","lineHeight":"28.39px","color":"rgb(105, 105, 105)","textAlign":"left","maxWidth":"100%"}}},{"kind":"spacer","height":{"xl":{"height":"32px"}}},{"kind":"heading","tag":"h4","text":"انضم إلى داتاهب للتنقل بشكل آمن في المشهد الرقمي.","style":{"xl":{"fontSize":"20px","fontWeight":"400","lineHeight":"28px","color":"rgb(0, 68, 147)","textAlign":"left","maxWidth":"100%"}}},{"kind":"spacer","height":{"xl":{"height":"32px"}}},{"kind":"buttons","buttons":[{"label":"تحميل الكتيب","href":"/assets/uploads/2023/09/DataHub-Anlaytics-company-profile-Full-v3.pdf","variant":"flat","icon":null,"iconPosition":"right","style":{"xl":{"fontSize":"14px","fontWeight":"400","lineHeight":"56px","color":"rgb(255, 255, 255)","backgroundColor":"rgb(15, 86, 213)","borderRadius":"5px","height":"56px","minWidth":"205px","paddingLeft":"36px","paddingRight":"36px"}},"newTab":true}],"align":"right"}]}]}]}]},{"kind":"row","id":"tm-row-6af317554f352","fullWidth":false,"stretchContent":false,"style":{"xl":{}},"separators":[],"columns":[{"kind":"column","width":{"md":12},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"spacer","height":{"xl":{"h