fontWeight":"400","lineHeight":"56.16px","color":"rgb(0, 68, 147)","textAlign":"center","display":"inline"},"md":{"fontSize":"36px","lineHeight":"42.12px"}}},{"kind":"spacer","height":{"xl":{"height":"20px"},"md":{"height":"10px"}}},{"kind":"heading","tag":"h4","text":"مدفوعة بخبرة حلول المؤسسات بقطاعات مختلفة","style":{"xl":{"fontSize":"17px","fontWeight":"400","lineHeight":"23.8px","color":"rgb(112, 112, 112)","textTransform":"uppercase","textAlign":"center","maxWidth":"100%"}}},{"kind":"spacer","height":{"xl":{"height":"100px"},"md":{"height":"50px"}}},{"kind":"list","variant":"auto-numbered-02","items":[{"title":"تقييم نضج إدارة البيانات الحالية","text":"نبدأ بإجراء تقييم شامل لممارسات إدارة البيانات في مؤسستك عبر مجالات معرفية العشر الأساسية المذكورة أعلاه. يساعدنا هذا التقييم في فهم نقاط القوة الحالية وتحديد المجالات التي تتطلب التحسين.","number":"01"},{"title":"تحديد الفجوات والمجالات التي تطلب التحسين","text":"بناءً على التقييم، نقوم بتحديد الثغرات والمجالات التي تحتاج فيها ممارسات إدارة البيانات إلى تحسين أو مواءمة مع مبادئ إطار إدارة البيانات وتشكل هذه التحليلات الأساس لإنشاء استراتيجية تنفيذ مصممة خصيصا.","number":"02"},{"title":"تطوير خطة عمل للتنفيذ","text":"يقوم فريقنا المتخصص بالعمل بشكل وثيق معك لتطوير خطة عمل مصممة خصيصا توضح الخطوات اللازمة والمعالم الزمنية والمواعيد النهائية لتنفيذ إطار إدارة البيانات. نحن نعطي الأولوية للمجالات الرئيسية لضمان اتباع نهج تدريجي واستراتيجي.","number":"03"},{"title":"تعيين الأدوار والمسؤوليات","text":"يعتمد نجاح إدارة البيانات على أدوار ومسؤوليات واضحة. نحن نساعدك في تحديد الأدوار المناسبة، مثل مشرفي البيانات ومهندسي البيانات ومدراء ادارة البيانات، مما يضمن المساءلة والحوكمة الفعّالة للبيانات.","number":"04"},{"title":"توفير التدريب والدعم","text":"إن التزامنا يمتد إلى ما بعد التنفيذ. نحن نقدم تدريبًا شاملاً لفريقك، مضمنين أنهم ملمون بإطار إدارة البيانات ومجهزين بالموارد والأدوات اللازمة للاعتماد الناجح.","number":"05"},{"title":"مراقبة وقياس التقدم","text":"المراقبة المستمرة أمر بالغ الأهمية لتحقيق للنجاح. نحن نقوم بتقييم التقدم في تنفيذ إطار إدارة البيانات بانتظام ونقيس تأثيرها على فعالية إدارة البيانات الخاصة بك. يتيح لنا هذا التقييم المستمر فرصة إجراء التعديلات اللازمة وضمان التحسين المستمر.","number":"06"}],"style":{"xl":{"textAlign":"left"}},"columns":{"xl":{"gridTemplateColumns":"2","columnGap":"30px","rowGap":"62px"},"md":{"gridTemplateColumns":"1"}},"parts":{"item":{"xl":{"fontSize":"15px","fontWeight":"400","lineHeight":"26.1px","color":"rgb(105, 105, 105)","textAlign":"left"}},"marker":{"xl":{"fontSize":"24px","fontWeight":"800","lineHeight":"28.8px","color":"rgb(42, 146, 67)","textAlign":"left"}},"title":{"xl":{"fontSize":"24px","fontWeight":"400","lineHeight":"28.8px","color":"rgb(51, 51, 51)","textAlign":"left","marginTop":"14px","paddingTop":"20px"}},"text":{"xl":{"fontSize":"15px","fontWeight":"400","lineHeight":"26.1px","color":"rgb(105, 105, 105)","textAlign":"left","marginTop":"21px"}}}},{"kind":"spacer","height":{"xl":{"height":"75px"},"md":{"height":"50px"}}}]}]},{"kind":"row","id":"tm-row-6af318de4bed7","fullWidth":true,"stretchContent":false,"style":{"xl":{"paddingBottom":"50px"}},"separators":[],"columns":[{"kind":"column","width":{"md":12},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"spacer","height":{"xl":{"height":"100px"},"md":{"height":"50px"}}},{"kind":"row","id":"tm-row-inner-6af318de4d2ae","fullWidth":false,"stretchContent":false,"style":{"xl":{}},"separators":[],"align":"middle","columns":[{"kind":"column","width":{"md":6},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"heading","tag":"h4","text":"لماذا","style":{"xl":{"fontSize":"40px","fontWeight":"400","lineHeight":"56px","color":"rgb(51, 51, 51)","textAlign":"center","maxWidth":"570px","display":"inline-block"},"md":{"fontSize":"28px","lineHeight":"39.2px"}}},{"kind":"spacer","height":{"xl":{"height":"32px"}}},{"kind":"image","image":{"src":"/assets/uploads/2023/07/databubanalytics_logo_2.png","alt":"databubanalytics_logo_2","width":746,"height":136},"style":{"xl":{"textAlign":"right"}},"imageStyle":{"xl":{"width":"570px","maxWidth":"100%"},"md":{"width":"330px"},"xs":{"width":"360px"}}}]},{"kind":"column","width":{"md":6},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"heading","tag":"h4","text":"شركاؤك الموثوق بهم لتحليل البيانات والبنية التحتية والأمان","style":{"xl":{"fontSize":"20px","fontWeight":"600","lineHeight":"28px","color":"rgb(51, 51, 51)","textAlign":"left","maxWidth":"100%","paddingLeft":"34px"}}},{"kind":"spacer","height":{"xl":{"height":"32px"}}},{"kind":"list","variant":"check","items":[{"title":"يتكون فريقنا من محترفي إدارة البيانات من ذوي الخبرة الواسعة في تنفيذ إطار إدارة البيانات في مختلف القطاعات والهياكل التنظيمية."},{"title":"بفضل سنوات الخبرة، نجحنا في تنفيذ مشاريع إطار إدارة البيانات بنجاح، مما يمكّن المؤسسات من تحسين ممارسات إدارة بياناتها وتحقيق نتائج ملموسة."},{"title":"ترتكز خدماتنا على أفضل الممارسات في الصناعة ومبادئ إطار إدارة البيانات، مما يضمن توافق إدارة البيانات لديك مع المعايير المعترف بها عالمياً."},{"title":"بالإضافة إلى التنفيذ، نحن نعزز الثقافة القائمة على البيانات داخل مؤسستك، ونقوم بتزويد فريقك بالمعرفة والمهارات اللازمة للاستفادة من البيانات كأصل استراتيجي."},{"title":"بدءا من التقييم الأولي وحتى المراقبة بعد التنفيذ، نحن نقدم الدعم الشامل، مما يضمن تكامل إطار إدارة البيانات بسلاسة وبشكل فعال في عمليات البيانات الخاصة بك."}],"style":{"xl":{"textAlign":"left"}},"columns":{"xl":{"gridTemplateColumns":"1","columnGap":"30px","rowGap":"12px"}},"parts":{"item":{"xl":{"fontSize":"15px","fontWeight":"400","lineHeight":"26.1px","color":"rgb(105, 105, 105)","textAlign":"left","paddingLeft":"32px"}},"marker":{"xl":{"fontSize":"15px","fontWeight":"400","lineHeight":"26.1px","color":"rgb(42, 146, 67)","textAlign":"left"}},"title":{"xl":{"fontSize":"16px","fontWeight":"400","lineHeight":"27.84px","color":"rgb(105, 105, 105)","textAlign":"left"}}}}]}]},{"kind":"spacer","height":{"xl":{"height":"100px"},"md":{"height":"50px"}}}]}]},{"kind":"row","id":"tm-row-6af318de65c6e","fullWidth":false,"stretchContent":false,"style":{"xl":{}},"separators":[],"columns":[{"kind":"column","width":{"md":12},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"spacer","height":{"xl":{"height":"80px"}}},{"kind":"heading","tag":"h3","text":"الأسئلة المتكررة","style":{"xl":{"fontSize":"32px","fontWeight":"400","lineHeight":"45.44px","color":"rgb(51, 51, 51)","textAlign":"left","maxWidth":"100%"}}},{"kind":"spacer","height":{"xl":{"height":"30px"}}},{"kind":"accordion","items":[{"title":"ما هو إطار إدارة البيانات، وكيف يمكن أن تستفيد منه مؤسستي؟","html":"إطار إدارة البيانات هو نهج منظم يضمن إدارة البيانات بشكل فعال وأمنها واستخدامها بكفاءة. تم إنشاؤه من قبل DAMA International، وهي منظمة غير ربحية مكرسة لتطوير مفاهيم وممارسات في إدارة البيانات. يمكن أن تستفيد مؤسستك منه من خلال تحسين جودة البيانات، وتحسين عملية اتخاذ القرارات، وتبسيط عمليات البيانات، وضمان الامتثال للتشريعات المتعلقة بالبيانات."},{"title":"كيف ستتم مواءمة خدمات إطار إدارة البيانات الخاصة بكم مع احتياجات عملنا الفريدة؟","html":"تتم تصميم خدماتنا لإطار إدارة البيانات لتلبية متطلبات عملكم الفريدة. نقوم بإجراء بتقييم شامل لممارسات إدارة البيانات الحالية لديكم ونطور خطة عمل مخصصة متماشية مع أهدافكم والتحديات التي تواجهونها."},{"title":"ما هو مستوى الخبرة الذي يمتلكه فريقكم في تنفيذ إطار إدارة البيانات؟","html":"يضم فريقنا محترفي إدارة البيانات من ذوي الخبرة الواسعة في تنفيذ إطار إدارة البيانات عبر مختلف القطاعات. لدينا سجل حافل بالنجاحات في مشاريع إطار إدارة البيانات، حيث نقوم بتقديم نتائج ملموسة لعملائنا."},{"title":"ما هو الدعم المستمر الذي تقدمونه بعد تنفيذ إطار إدارة البيانات؟","html":"نحن نؤمن بتقديم الدعم المستمر لضمان النجاح المستدام لإطار إدارة البيانات داخل مؤسستكم. يقدم فريقنا خدمات متابعة دورية وتحسين العمليات والتدريب لتمكين فريقكم بالمهارات والمعرفة اللازمة لإدارة البيانات بشكل فعّال."},{"title":"كيف يمكن لإطار إدارة البيانات أن يعزز ثقافة البيانات داخل مؤسستنا؟","html":"يعزز إطار إدارة البيانات ثقافة البيانات من خلال تحديد الأدوار والمسؤوليات وممارسات ادارة البيانات بشكل واضح. كما يمكّن فريقكم من اتخاذ قرارات مستنيرة مستندة إلى بيانات موثوقة، مما يعزز الابتكار والكفاءة في جميع أنحاء المؤسسة."}],"style":{"xl":{}},"parts":{"section":{"xl":{"fontSize":"16px","fontWeight":"400","lineHeight":"27.84px","color":"rgb(105, 105, 105)","backgroundColor":"rgb(255, 255, 255)"}},"title":{"xl":{"fontSize":"18px","fontWeight":"500","lineHeight":"22.14px","color":"rgb(255, 255, 255)","paddingTop":"18px","paddingBottom":"18px","backgroundColor":"rgb(0, 68, 147)","borderBottom":"1px solid rgba(0, 0, 0, 0)","paddingLeft":"30px","paddingRight":"30px"}},"content":{"xl":{"fontSize":"16px","fontWeight":"400","lineHeight":"27.84px","color":"rgb(105, 105, 105)","paddingTop":"23px","paddingBottom":"29px","paddingLeft":"30px","paddingRight":"30px"}}}},{"kind":"spacer","height":{"xl":{"height":"100px"},"md":{"height":"50px"}}}]}]}]}
