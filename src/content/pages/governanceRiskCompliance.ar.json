px","fontWeight":"400","lineHeight":"26.1px","color":"rgb(105, 105, 105)","textAlign":"left","marginTop":"10px"}},"content":{"xl":{"fontSize":"15px","fontWeight":"400","lineHeight":"26.1px","color":"rgb(105, 105, 105)","textAlign":"left"}}}},{"kind":"box","variant":"icon-05","heading":"التحسين المستمر","subHeading":"06","textHtml":"قم بتعزيز ثقافة التحسين المستمر من خلال التقييمات الدورية وعمليات التدقيق وتحسين ممارسات الحوكمة والمخاطر والامتثال.","style":{"xl":{"paddingTop":"19px","paddingBottom":"30px","backgroundColor":"rgb(244, 238, 252)","borderRadius":"5px","paddingLeft":"24px","paddingRight":"24px"}},"parts":{"wrap":{"xl":{"textAlign":"left"}},"heading":{"xl":{"fontSize":"18px","fontWeight":"700","lineHeight":"22.5px","color":"rgb(51, 51, 51)","textAlign":"left"}},"subHeading":{"xl":{"fontSize":"15px","fontWeight":"500","lineHeight":"21.3px","color":"rgb(130, 36, 227)","textAlign":"left","marginBottom":"7px"}},"text":{"xl":{"fontSize":"15px","fontWeight":"400","lineHeight":"26.1px","color":"rgb(105, 105, 105)","textAlign":"left","marginTop":"10px"}},"content":{"xl":{"fontSize":"15px","fontWeight":"400","lineHeight":"26.1px","color":"rgb(105, 105, 105)","textAlign":"left"}}}}]}]}]},{"kind":"row","id":"tm-row-6af318d42c4d3","fullWidth":true,"stretchContent":false,"style":{"xl":{"paddingBottom":"50px"}},"separators":[],"columns":[{"kind":"column","width":{"md":12},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"spacer","height":{"xl":{"height":"80px"}}},{"kind":"row","id":"tm-row-inner-6af318d42c8cf","fullWidth":false,"stretchContent":false,"style":{"xl":{}},"separators":[],"align":"middle","columns":[{"kind":"column","width":{"md":6},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"heading","tag":"h4","text":"لماذا","style":{"xl":{"fontSize":"40px","fontWeight":"400","lineHeight":"56px","color":"rgb(51, 51, 51)","textAlign":"center","maxWidth":"570px","display":"inline-block"},"md":{"fontSize":"28px","lineHeight":"39.2px"}}},{"kind":"spacer","height":{"xl":{"height":"32px"}}},{"kind":"image","image":{"src":"/assets/uploads/2023/07/databubanalytics_logo_2.png","alt":"databubanalytics_logo_2","width":746,"height":136},"style":{"xl":{"textAlign":"right"}},"imageStyle":{"xl":{"width":"570px","maxWidth":"100%"},"md":{"width":"330px"},"xs":{"width":"360px"}}}]},{"kind":"column","width":{"md":6},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"heading","tag":"h4","text":"شركاؤك الموثوق بهم لتحليل البيانات والبنية التحتية والأمان","style":{"xl":{"fontSize":"20px","fontWeight":"600","lineHeight":"28px","color":"rgb(51, 51, 51)","textAlign":"left","maxWidth":"100%","paddingLeft":"34px"}}},{"kind":"spacer","height":{"xl":{"height":"32px"}}},{"kind":"list","variant":"check","items":[{"title":"تم اعتماد خبراؤنا في مجموعة متنوعة من إطارات الحوكمة والمخاطر والامتثال، بما في ذلك ISO 27001، وNIST، وغيرها، مما يضمن توجيهًا متميزًا وامتثالًا للمعايير الصناعية."},{"title":"نحن نتبع نهجًا مخصصًا، حيث نقوم بتصميم خدماتنا في الحوكمة والمخاطر والامتثال وفقًا لاحتياجات مؤسستك الخاصة وملفات تعريف المخاطر وأهداف العمل."},{"title":"بسجلنا الحافل في مختلف القطاعات، نقدم معلومات وحلول متخصصة في الصناعة مصممة خصيصًا لتلبية احتياجات عملك الفريدة."},{"title":"من خلال الاستفادة من الأدوات والمنهجيات المتقدمة، نقدم معلومات قائمة على البيانات لإدارة المخاطر بشكل فعال وتطبيق استراتيجيات الامتثال."},{"title":"بدءا من التقييمات الأولية وحتى المراقبة المستمرة، نقوم بتقديم التوجيه والدعم المستمر طوال عملية تنفيذ الحوكمة والمخاطر والامتثال."}],"style":{"xl":{"textAlign":"left"}},"columns":{"xl":{"gridTemplateColumns":"1","columnGap":"30px","rowGap":"12px"}},"parts":{"item":{"xl":{"fontSize":"15px","fontWeight":"400","lineHeight":"26.1px","color":"rgb(105, 105, 105)","textAlign":"left","paddingLeft":"32px"}},"marker":{"xl":{"fontSize":"15px","fontWeight":"400","lineHeight":"26.1px","color":"rgb(42, 146, 67)","textAlign":"left"}},"title":{"xl":{"fontSize":"16px","fontWeight":"400","lineHeight":"27.84px","color":"rgb(105, 105, 105)","textAlign":"left"}}}}]}]},{"kind":"spacer","height":{"xl":{"height":"80px"}}}]}]},{"kind":"row","id":"tm-row-6af318d441fc1","fullWidth":false,"stretchContent":false,"style":{"xl":{}},"separators":[],"columns":[{"kind":"column","width":{"md":12},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"spacer","height":{"xl":{"height":"80px"}}},{"kind":"heading","tag":"h3","text":"الأسئلة المتكررة","style":{"xl":{"fontSize":"32px","fontWeight":"400","lineHeight":"45.44px","color":"rgb(51, 51, 51)","textAlign":"left","maxWidth":"100%"}}},{"kind":"spacer","height":{"xl":{"height":"30px"}}},{"kind":"accordion","items":[{"title":"ما هو الفرق بين ISO 27001:2022 وإطار أمن المعلومات من المعهد الوطني للمعايير والتكنولوجيا (NIST)؟","html":"ISO 27001:2022 هو معيار دولي يوفر نهجًا منظما لإدارة مخاطر أمن المعلومات. يركز على إنشاء وتنفيذ وصيانة وتحسين نظام إدارة أمن المعلومات (ISMS) داخل المؤسسة بشكل مستمر. من ناحية أخرى، إطار أمن المعلومات من المعهد الوطني للمعايير والتكنولوجيا (NIST) هو إطار طوعي تم تطويره من قبل المعهد الوطني للمعايير والتكنولوجيا (NIST) في الولايات المتحدة. وهو يقدم نهجاً مرناً لإدارة وتقليل مخاطر أمن المعلومات استناداً إلى خمس وظائف أساسية: التحديد، والحماية، والكشف، والاستجابة، والاستعادة."},{"title":"هل يمكن لخدماتكم مساعدتنا في تحقيق الامتثال مع كل من ISO 27001:2022 وإطار أمن المعلومات من المعهد الوطني للمعايير والتكنولوجيا (NIST)؟","html":"نعم، تم تصميم خدماتنا لمساعدة المؤسسات في تحقيق الامتثال مع كل من ISO 27001:2022 وإطار أمن المعلومات من المعهد الوطني للمعايير والتكنولوجيا (NIST). نحن نقوم بتخصيص نهجنا ليتناسب مع متطلبات الامتثال الخاصة بكم وبأهداف عملكم، مما يضمن تنفيذاً شاملاً وفعّالاً لكل من المعيارين."},{"title":"كيف تقومون بتقييم استعداد مؤسستنا لمعيارـ ISO 27001:2022 وإطار أمن المعلومات من المعهد الوطني للمعايير والتكنولوجيا (NIST)؟","html":"يقوم خبراؤنا بإجراء تقييم شامل لممارسات أمن المعلومات الحالية وتدابير الأمن السيبراني الخاصة بكم. نحدد الثغرات والمجالات التي تحتاج إلى تحسين للمواءمة مع متطلبات ISO 27001:2022 وإطار أمن المعلومات من المعهد الوطني للمعايير والتكنولوجيا (NIST). بناءً على نتائج التقييم، نقوم بتطوير خطة عمل مخصصة للتنفيذ."},{"title":"كيف ستستفيد مؤسستنا من التوافق مع ISO 27001:2022 وإطار أمن المعلومات من المعهد الوطني للمعايير والتكنولوجيا (NIST)؟","html":"يوفر الامتثال مع ISO 27001:2022 وإطار أمن المعلومات من المعهد الوطني للمعايير والتكنولوجيا (NIST) العديد من المزايا، بما في ذلك تعزيز موقف الأمن السيبراني، وتقليل مخاطر اختراقات البيانات، وتحسين قدرات الاستجابة للحوادث، وزيادة ثقة العملاء والشركاء. كما أنه يساعد المؤسسات على اظهار التزامها بحماية البيانات الحساسة والالتزام بأفضل الممارسات الدولية للأمان السيبراني."},{"title":"هل ستقدمون الدعم والمراقبة المستمرة بعد التنفيذ؟","html":"نعم، دعمنا لا ينتهي مع التنفيذ الأولي. نحن نقدم دعمًا مستمرًا، بما في ذلك التدريب والمراقبة والتوجيه للحفاظ على الامتثال مع معيار ISO 27001:2022 وإطار أمن المعلومات من المعهد الوطني للمعايير والتكنولوجيا (NIST). هدفنا هو ضمان النجاح الطويل الأمد لمؤسستكم في إدارة مخاطر أمن المعلومات والتهديدات السيبرانية بشكل فعّال."}],"style":{"xl":{}},"parts":{"section":{"xl":{"fontSize":"16px","fontWeight":"400","lineHeight":"27.84px","color":"rgb(105, 105, 105)","backgroundColor":"rgb(255, 255, 255)"}},"title":{"xl":{"fontSize":"18px","fontWeight":"500","lineHeight":"22.14px","color":"rgb(255, 255, 255)","paddingTop":"18px","paddingBottom":"18px","backgroundColor":"rgb(0, 68, 147)","borderBottom":"1px solid rgba(0, 0, 0, 0)","paddingLeft":"30px","paddingRight":"30px"}},"content":{"xl":{"fontSize":"16px","fontWeight":"400","lineHeight":"27.84px","color":"rgb(105, 105, 105)","paddingTop":"23px","paddingBottom":"29px","paddingLeft":"30px","paddingRight":"30px"}}}},{"kind":"spacer","height":{"xl":{},"md":{"height":"70px"}}},{"kind":"spacer","height":{"xl":{"height":"100px"}}}]}]}]}
