ontSize":"18px","fontWeight":"500","lineHeight":"25.56px","color":"rgb(255, 255, 255)","textAlign":"left","maxWidth":"100%","display":"inline-block"}}},{"kind":"spacer","height":{"xl":{"height":"56px"}}},{"kind":"buttons","buttons":[{"label":"احجز استشارة مجانية","href":"#section-consultation","variant":"flat","icon":null,"iconPosition":"right","style":{"xl":{"fontSize":"14px","fontWeight":"400","lineHeight":"56px","color":"rgb(255, 255, 255)","backgroundColor":"rgb(15, 86, 213)","borderRadius":"5px","height":"56px","minWidth":"175px","paddingLeft":"36px","paddingRight":"36px"}},"newTab":false}],"align":"start"},{"kind":"spacer","height":{"xl":{"height":"200px"}}}]}]},{"kind":"row","id":"tm-row-6af318d3ea002","fullWidth":true,"stretchContent":false,"style":{"xl":{"paddingBottom":"120px"},"md":{"paddingBottom":"100px"}},"separators":[{"position":"bottom","viewBox":"0 0 4.66666 0.333331","paths":["M-7.87402e-006 0.0148858l0.00234646 0c0.052689,0.0154094 0.554437,0.154539 1.51807,0.166524l0.267925 0c0.0227165,-0.00026378 0.0456102,-0.000582677 0.0687992,-0.001 1.1559,-0.0208465 2.34191,-0.147224 2.79148,-0.165524l0.0180591 0 0 0.166661 -7.87402e-006 0 0 0.151783 -4.66666 0 0 -0.151783 -7.87402e-006 0 0 -0.166661z"],"color":"rgb(0, 68, 147)","height":{"xl":{"height":"100px"}}}],"align":"middle","columns":[{"kind":"column","width":{"md":12},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"heading","tag":"h3","text":[{"mark":"ابق ملتزماً، ابق آمناً"}],"style":{"xl":{"fontSize":"50px","fontWeight":"400","lineHeight":"64.5px","color":"rgb(51, 51, 51)","textAlign":"left","marginBottom":"25px","maxWidth":"100%"},"md":{"fontSize":"40px","lineHeight":"51.6px"}},"markStyle":{"xl":{"fontSize":"50px","fontWeight":"400","lineHeight":"64.5px","color":"rgb(0, 68, 147)","textAlign":"left","display":"inline"},"md":{"fontSize":"40px","lineHeight":"51.6px"}}}]},{"kind":"column","width":{"md":12,"lg":5},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"spacer","height":{"xl":{"height":"50px"},"md":{"height":"30px"}}},{"kind":"heading","tag":"h3","text":"لقد شهدت الشركات التي تمتلك عمليات GRC ناضجة انخفاضًا بنسبة 53٪ في حالات خرق الأمن مقارنة بتلك التي تمتلك عمليات أقل نضجًا.","style":{"xl":{"fontSize":"24px","fontWeight":"800","lineHeight":"40.08px","color":"rgb(51, 51, 51)","textAlign":"left","marginBottom":"25px","maxWidth":"400px","paddingLeft":"34px"},"md":{"fontSize":"18px","lineHeight":"30.06px"}}},{"kind":"spacer","height":{"xl":{"height":"100px"},"md":{"height":"30px"}}}]},{"kind":"column","width":{"md":12,"lg":7},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"heading","tag":"div","text":"في بيئة الأعمال الديناميكية اليوم، تواجه المؤسسات عدد من التحديات المتعلقة بالحوكمة والمخاطر والامتثال. يشكل التقدم السريع في التكنولوجيا والتهديدات السيبرانية المتطورة باستمرار مخاطر كبيرة على البيانات الحساسة والأصول. تعد انتهاكات البيانات والخسائر المالية والضرر على سمعة الشركة من المخاوف المستمرة. علاوة على ذلك، فإن التوافق مع اللوائح الخاصة بالصناعة مع ضمان خصوصية البيانات يمثل صراع مستمر. وبدون اتباع نهج شامل واستباقي للحوكمة والمخاطر والامتثال، تتعرض المؤسسات لعواقب قانونية ومسؤوليات مالية وفقدان ثقة العملاء.","style":{"xl":{"fontSize":"17px","fontWeight":"400","lineHeight":"28.39px","color":"rgb(105, 105, 105)","textAlign":"left","maxWidth":"100%"}}},{"kind":"spacer","height":{"xl":{"height":"50px"},"md":{"height":"30px"}}},{"kind":"heading","tag":"div","text":"في داتاهب، نحن نفهم أهمية التعامل مع هذه التحديات. تم تصميم خدماتنا في الحوكمة والمخاطر والامتثال لدعم المؤسسات للتغلب على تعقيدات المتطلبات التنظيمية، وتحديد المخاطر وتخفيفها، وتعزيز وضعها الأمني. مع فريق من المحترفين من ذوي الخبرة وباتباع نهج مستند إلى البيانات، نمكن المؤسسات من اتخاذ قرارات مستنيرة، وحماية المعلومات الحساسة بشكل استباقي، وبناء أساس مرن ضد التهديدات السيبرانية المتطورة باستمرار. ومن خلال الاستفادة من خبراتنا، يمكن للشركات تعزيز ممارساتها في الحوكمة، وتعزيز استراتيجيات إدارة المخاطر، وضمان الالتزام بأفضل ممارسات الصناعة، مما يعزز الثقة في عملياتها.","style":{"xl":{"fontSize":"17px","fontWeight":"400","lineHeight":"28.39px","color":"rgb(105, 105, 105)","textAlign":"left","maxWidth":"100%"}}},{"kind":"spacer","height":{"xl":{"height":"32px"}}},{"kind":"heading","tag":"h4","text":"انضم إلى داتاهب لتحسين الامتثال وتقليل المخاطر.","style":{"xl":{"fontSize":"20px","fontWeight":"400","lineHeight":"28px","color":"rgb(0, 68, 147)","textAlign":"left","maxWidth":"100%"}}}]}]},{"kind":"row","id":"tm-row-6af318d3ebdd6","fullWidth":true,"stretchContent":false,"style":{"xl":{"backgroundColor":"rgb(255, 255, 255)"}},"separators":[{"position":"bottom","viewBox":"0 0 2.23333 0.1","paths":["M2.23281 0.0372047c0,0 -0.0261929,-0.000389764 -0.0423307,-0.00584252 0,0 -0.0356181,0.0278268 -0.0865354,0.0212205 0,0 -0.0347835,-0.00524803 -0.0579094,-0.0283701 0,0 -0.0334252,0.0112677 -0.0773425,-0.00116929 0,0 -0.0590787,0.0524724 -0.141472,0.000779528 0,0 -0.0288189,0.0189291 -0.0762362,0.0111535 -0.00458268,0.0141024 -0.0150945,0.040122 -0.0656811,0.0432598 -0.0505866,0.0031378 -0.076126,-0.0226614 -0.0808425,-0.0308228 -0.00806299,0.000854331 -0.0819961,0.0186969 -0.111488,-0.022815 -0.0076378,0.0114843 -0.059185,0.0252598 -0.083563,-0.000385827 -0.0295945,0.0508661 -0.111996,0.0664843 -0.153752,0.019 -0.0179843,0.00227559 -0.0571181,0.00573622 -0.0732795,-0.0152953 -0.027748,0.0419646 -0.110602,0.0366654 -0.138701,0.00688189 0,0 -0.0771732,0.0395709 -0.116598,-0.0147677 0,0 -0.0497598,0.02 -0.0773346,-0.00166929 0,0 -0.0479646,0.0302756 -0.0998937,0.00944094 0,0 -0.0252638,0.0107874 -0.0839488,0.00884646 0,0 -0.046252,0.000775591 -0.0734567,-0.0237087 0,0 -0.046252,0.0101024 -0.0769567,-0.00116929 0,0 -0.0450827,0.0314843 -0.118543,0.0108858 0,0 -0.0715118,0.0609803 -0.144579,0.00423228 0,0 -0.0385787,0.00770079 -0.0646299,0.000102362 0,0 -0.0387559,0.0432205 -0.125039,0.0206811 0,0 -0.0324409,0.0181024 -0.0621457,0.0111063l-3.93701e-005 0.0412205 2.2323 0 0 -0.0627953z"],"color":"rgb(255, 255, 255)","height":{"xl":{"height":"100px"}}}],"columns":[{"kind":"column","width":{"md":12},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"spacer","height":{"xl":{"height":"50px"}}},{"kind":"heading","tag":"h2","text":[{"mark":"مجموعة خدمات الحوكمة والمخاطر والامتثال"}],"style":{"xl":{"fontSize":"48px","fontWeight":"400","lineHeight":"56.16px","color":"rgb(51, 51, 51)","textAlign":"center","maxWidth":"930px"},"md":{"fontSize":"36px","lineHeight":"42.12px"}},"markStyle":{"xl":{"fontSize":"48px","fontWeight":"400","lineHeight":"56.16px","color":"rgb(0, 68, 147)","textAlign":"center","display":"inline"},"md":{"fontSize":"36px","lineHeight":"42.12px"}}},{"kind":"spacer","height":{"xl":{"height":"20px"},"md":{"height":"10px"}}},{"kind":"heading","tag":"h4","text":"مدفوعة بخبرة حلول المؤسسات بقطاعات مختلفة","style":{"xl":{"fontSize":"17px","fontWeight":"400","lineHeight":"23.8px","color":"rgb(112, 112, 112)","textTransform":"uppercase","textAlign":"center","maxWidth":"100%"}}},{"kind":"spacer","height":{"xl":{"height":"100px"}}},{"kind":"row","id":"tm-row-inner-6af318d3ed550","fullWidth":false,"stretchContent":false,"style":{"xl":{}},"separators":[],"align":"middle","columns":[{"kind":"column","width":{"md":6},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"image","image":{"src":"/assets/uploads/2023/08/iso27001-1200x627-1-1024x535-1.jpg","alt":"iso27001-1200x627-1-1024x535-1","width":1024,"height":535},"style":{"xl":{"textAlign":"right"}},"imageStyle":{"xl":{"width":"570px","maxWidth":"100%"},"md":{"width":"330px"},"xs":{"width":"360px"}}},{"kind":"spacer","height":{"xl":{"height":"32px"}}}]},{"kind":"column","width":{"md":6},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"heading","tag":"h4","text":"ISO 27001:2022","style":{"xl":{"fontSize":"35px","fontWeight":"600","lineHeight":"49px","color":"rgb(0, 0, 0)","textAlign":"left","maxWidth":"100%","paddingLeft":"34px"},"md":{"fontSize":"30px","lineHeight":"42px"},"xs":{"fontSize":"25px","lineHeight":"35px"}}},{"kind":"spacer","height":{"xl":{"height":"32px"}}},{"kind":"heading","tag":"div","text":"في داتاهب، تقدم خدمتنا ISO 27001:2022 عرضًا شاملاً مصممًا لمساعدة المؤسسات على تحقيق والحفاظ على الامتثال مع معيار ISO 27001. نحن نقوم بتوجيه الشركات من خلال عملية دقيقة تتضمن تقييم نظام إدارة أمن المعلومات الحالي الخاص بها، وتحديد الثغرات ونقاط الضعف، وإنشاء خطة عمل مخصصة للحصول على شهادة ISO 27001:2022. يعمل فريقنا من الخبراء المعتمدين بشكل وثيق مع العملاء لتطوير سياسات قوية لأمن المعلومات، وتنفيذ الضوابط اللازمة، وتقديم الدعم المستمر لضمان الحصول على شهادات الاعتماد المطلوبة والقيام بالتحسين المستمر.","style":{"xl":{"fontSize":"17px","fontWeight":"400","lineHeight":"28.39px","color":"rgb(105, 105, 105)","textAlign":"left","maxWidth":"100%"}}}]},{"kind":"column","width":{"md":12},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"spacer","height":{"xl":{"height":"100px"},"md":{"height":"50px"}}},{"kind":"list","variant":"auto-numbered-02","items":[{"title":"تحليل الفجوات وتقييم الجاهزية","text":"يقوم خبراؤنا بتقييم شامل لنظام إدارة أمن المعلومات الحالي الخاص بك لتحديد الثغرات وتقييم مدى استعدادية مؤسستك للحصول على شهادة ISO 27001:2022.","number":"01"},{"title":"تقييم المخاطر ووضع خطة لمعالجتها","text":"نقوم بتقييم شامل للمخاطر لتحديد نقاط الضعف المحتملة وتحديد أولويات معالجة المخاطر. وبناء على النتائج، نقوم بمساعدتك في تطوير خطة فعالة لمعالجة المخاطر المحددة.","number":"02"},{"title":"تطوير سياسات أمن المعلومات","text":"يتعاون فريقنا مع مؤسستك لتطوير وتنفيذ سياسات أمن المعلومات تتماشى مع متطلبات ISO 27001:2022 ومصممة وفقًا لاحتياجات عملك المحددة.","number":"03"},{"title":"ضوابط التنفيذ والمراقبة","text":"نوجهك في تنفيذ الضوابط اللازمة لتقليل المخاطر وضمان الامتثال. كما تقوم عمليات المراقبة لدينا ودعمنا المستمر و في مساعدتنا على تتبع فعالية الضوابط وضمان التحسين المستمر.","number":"04"},{"title":"دعم الشهادات","text":"في داتاهب نقوم بتوفير دعمًا شاملاً أثناء عملية الحصول على شهادة ISO 27001:2022، بما في ذلك تقييمات الجاهزية، والتوجيه أثناء عمليات التدقيق، والمساعدة في معالجة أي حالة لعدم المطابقة، مما يضمن رحلة ناجحة للحصول على شهادات الاعتماد لمؤسستك.","number":"05"}],"style":{"xl":{"textAlign":"left"}},"columns":{"xl":{"gridTemplateColumns":"2","columnGap":"30px","rowGap":"62px"},"md":{"gridTemplateColumns":"1"}},"parts":{"item":{"xl":{"fontSize":"15px","fontWeight":"400","lineHeight":"26.1px","color":"rgb(105, 105, 105)","textAlign":"left"}},"marker":{"xl":{"fontSize":"24px","fontWeight":"800","lineHeight":"28.8px","color":"rgb(42, 146, 67)","textAlign":"left"}},"title":{"xl":{"fontSize":"24px","fontWeight":"400","lineHeight":"28.8px","color":"rgb(51, 51, 51)","textAlign":"left","marginTop":"14px","paddingTop":"20px"}},"text":{"xl":{"fontSize":"15px","fontWeight":"400","lineHeight":"26.1px","color":"rgb(105, 105, 105)","textAlign":"left","marginTop":"21px"}}}},{"kind":"separator","style":{"xl":{"borderTop":"1px solid rgb(221, 221, 221)"}}},{"kind":"spacer","height":{"xl":{"height":"100px"},"md":{"height":"50px"}}}]}]},{"kind":"row","id":"tm-row-inner-6af318d4122a2","fullWidth":false,"stretchContent":false,"style":{"xl":{}},"separators":[],"align":"middle","columns":[{"kind":"column","width":{"md":6},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"image","image":{"src":"/assets/uploads/2023/08/NIST-Cybersecuirty-Framework.png","alt":"NIST-Cybersecuirty-Framework","width":1165,"height":642},"style":{"xl":{"textAlign":"right"}},"imageStyle":{"xl":{"width":"570px","maxWidth":"100%"},"md":{"width":"330px"},"xs":{"width":"360px"}}},{"kind":"spacer","height":{"xl":{"height":"32px"}}}]},{"kind":"column","width":{"md":6},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"heading","tag":"h4","text":"إطار أمن المعلومات من المعهد الوطني للمعايير والتكنولوجيا (NIST)","style":{"xl":{"fontSize":"35px","fontWeight":"600","lineHeight":"49px","color":"rgb(0, 0, 0)","textAlign":"left","maxWidth":"100%","paddingLeft":"34px"},"md":{"fontSize":"30px","lineHeight":"42px"},"xs":{"fontSize":"25px","lineHeight":"35px"}}},{"kind":"spacer","height":{"xl":{"height":"32px"}}},{"kind":"heading","tag":"div","text":"في داتاهب، تقدم خدمتنا لإطار أمن المعلومات من المعهد الوطني للمعايير والتكنولوجيا (NIST) عرضًا متخصصًا مصممًا لمساعدة المؤسسات في تنفيذ إطار أمن المعلومات من المعهد الوطني للمعايير والتكنولوجيا (NIST) لتعزيز موقفها في مجال أمن المعلومات. نحن نقوم بتقديم نهجًا منظمًا ومنهجيًا لمساعدة الشركات على تحديد وتقييم وإدارة مخاطر أمن المعلومات بفعالية. يتعاون خبراؤنا المعتمدين بشكل وثيق مع العملاء لتطوير خطة عمل مخصصة لتنفيذ إطار أمن المعلومات من المعهد الوطني للمعايير والتكنولوجيا (NIST)، ومواءمتها مع متطلباتهم الفريدة للعمل وملفات تعريف المخاطر. نحن نقوم في توجيه المؤسسات في تنفيذ الوظائف الأساسية لإطار أمن المعلومات من المعهد الوطني للمعايير والتكنولوجيا (NIST)، بما في ذلك التحديد، والحماية، والكشف، والاستجابة، والاسترداد، مما يمكّن المؤسسة من معالجة التهديدات السيبرانية بشكل استباقي، وحماية الأصول المهمة، وإنشاء بيئة أمنية قوية ومرنة.","style":{"xl":{"fontSize":"17px","fontWeight":"400","lineHeight":"28.39px","color":"rgb(105, 105, 105)","textAlign":"left","maxWidth":"100%"}}}]},{"kind":"column","width":{"md":12},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"spacer","height":{"xl":{"height":"100px"},"md":{"height":"50px"}}},{"kind":"list","variant":"auto-numbered-02","items":[{"title":"تقييم الحالة الحالية","text":"يقوم خبراؤنا بتقييم شامل لممارسات أمن المعلومات الحالية في مؤسستك، لتحديد نقاط القوة والضعف والثغرات بما يتماشى مع إطار أمن المعلومات من المعهد الوطني للمعايير والتكنولوجيا (NIST).","number":"01"},{"title":"تطوير خطة العمل","text":"استنادًا إلى نتائج التقييم، نحن نقوم بالتعاون مع مؤسستك لتطوير خطة شاملة لتنفيذ إطار أمن المعلومات من المعهد الوطني للمعايير والتكنولوجيا (NIST)، مع التركيز على المجالات الرئيسية للتحسين.","number":"02"},{"title":"مواءمة وتكامل الإطار","text":"نساعدك في مواءمة ممارسات أمن المعلومات الحالية لديك مع وظائف إطار أمن المعلومات من المعهد الوطني للمعايير والتكنولوجيا (NIST) الأساسية - التحديد، والحماية، والكشف، والاستجابة، والاسترداد - لتطوير نهج أمني متماسك قائم على المخاطر.","number":"03"},{"title":"تنفيذ إدارة المخاطر","text":"يساعد فريقنا في تنفيذ استراتيجيات إدارة المخاطر، بما في ذلك تقييم المخاطر ووضع خطط لمعالجتها، وتكامل الضوابط الأمنية للتخفيف من المخاطر المحددة.","number":"04"},{"title":"الدعم والتحسين المستمر","text":"في داتاهب نقوم بتقديم دعمًا مستمرًا طوال فترة عملية التنفيذ، ونقدم التوجيهات اللازمة، ونراقب التقدم، ونجري تقييمات دورية لضمان الاعتماد الفعال لإطار أمن المعلومات من المعهد الوطني للمعايير والتكنولوجيا (NIST) وتعزيز ثقافة أمن المعلومات بشكل استباقي داخل مؤسستك.","number":"05"}],"style":{"xl":{"textAlign":"left"}},"columns":{"xl":{"gridTemplateColumns":"2","columnGap":"30px","rowGap":"62px"},"md":{"gridTemplateColumns":"1"}},"parts":{"item":{"xl":{"fontSize":"15px","fontWeight":"400","lineHeight":"26.1px","color":"rgb(105, 105, 105)","textAlign":"left"}},"marker":{"xl":{"fontSize":"24px","fontWeight":"800","lineHeight":"28.8px","color":"rgb(42, 146, 67)","textAlign":"left"}},"title":{"xl":{"fontSize":"24px","fontWeight":"400","lineHeight":"28.8px","color":"rgb(51, 51, 51)","textAlign":"left","marginTop":"14px","paddingTop":"20px"}},"text":{"xl":{"fontSize":"15px","fontWeight":"400","lineHeight":"26.1px","color":"rgb(105, 105, 105)","textAlign":"left","marginTop":"21px"}}}},{"kind":"separator","style":{"xl":{"borderTop":"1px solid rgb(221, 221, 221)"}}},{"kind":"spacer","height":{"xl":{"height":"75px"},"md":{"height":"50px"}}}]}]}]}]},{"kind":"row","id":"tm-row-6af318d42a355","fullWidth":true,"stretchContent":false,"style":{"xl":{"paddingTop":"50px","paddingBottom":"50px"}},"separators":[],"columns":[{"kind":"column","width":{"md":12},"style":{"xl":{"paddingLeft":"15px","paddingRight":"15px"},"xs":{"paddingLeft":"initial","paddingRight":"initial"}},"children":[{"kind":"heading","tag":"h2","text":[{"mark":"فوائد خدمات الحوكمة والمخاطر والامتثال"}],"style":{"xl":{"fontSize":"48px","fontWeight":"400","lineHeight":"56.16px","color":"rgb(51, 51, 51)","textAlign":"center","maxWidth":"930px"},"md":{"fontSize":"36px","lineHeight":"42.12px"}},"markStyle":{"xl":{"fontSize":"48px","fontWeight":"400","lineHeight":"56.16px","color":"rgb(0, 68, 147)","textAlign":"center","display":"inline"},"md":{"fontSize":"36px","lineHeight":"42.12px"}}},{"kind":"spacer","height":{"xl":{"height":"50px"}}},{"kind":"grid","columns":{"xl":{"gridTemplateColumns":"3","columnGap":"20px","rowGap":"40px"},"md":{"gridTemplateColumns":"2"},"xs":{"gridTemplateColumns":"1"}},"gap":{"xl":{"gridTemplateColumns":"3","columnGap":"20px","rowGap":"40px"},"md":{"gridTemplateColumns":"2"},"xs":{"gridTemplateColumns":"1"}},"children":[{"kind":"box","variant":"icon-05","heading":"تحسين إدارة المخاطر","subHeading":"01","textHtml":"قم بتعزيز عملية تحديد المخاطر وتحليلها ووضع استراتيجيات التخفيف، مما يضمن إدارة استباقية للتهديدات ونقات الضعف المحتملة.","style":{"xl":{"paddingTop":"19px","paddingBottom":"30px","backgroundColor":"rgb(250, 246, 243)","borderRadius":"5px","paddingLeft":"24px","paddingRight":"24px"}},"parts":{"wrap":{"xl":{"textAlign":"left"}},"heading":{"xl":{"fontSize":"18px","fontWeight":"700","lineHeight":"22.5px","color":"rgb(51, 51, 51)","textAlign":"left"}},"subHeading":{"xl":{"fontSize":"15px","fontWeight":"500","lineHeight":"21.3px