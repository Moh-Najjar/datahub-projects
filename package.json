{
  "name": "datahubprojects",
  "private": true,
  "description": "DataHub Analytics frontend monorepo: web and mobile applications plus shared TypeScript types.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:website": "npm run dev --workspace=apps/datahub-website",
    "build:website": "npm run build --workspace=apps/datahub-website",
    "preview:website": "npm run preview --workspace=apps/datahub-website",
    "lint:website": "npm run lint --workspace=apps/datahub-website",
    "dev:hr": "npm run start --workspace=apps/datahub-hr",
    "android:hr": "npm run android --workspace=apps/datahub-hr",
    "ios:hr": "npm run ios --workspace=apps/datahub-hr",
    "lint:hr": "npm run lint --workspace=apps/datahub-hr",
    "config:hr": "npm run config --workspace=apps/datahub-hr",
    "doctor:hr": "npm run doctor --workspace=apps/datahub-hr",
    "dev:admin": "npm run dev --workspace=apps/datahub-hr-admin-portal",
    "build:admin": "npm run build --workspace=apps/datahub-hr-admin-portal",
    "lint:admin": "npm run lint --workspace=apps/datahub-hr-admin-portal",
    "test:admin": "npm run test --workspace=apps/datahub-hr-admin-portal",
    "dev:trainee": "npm run dev --workspace=apps/datahub-trainee-app",
    "build:trainee": "npm run build --workspace=apps/datahub-trainee-app",
    "lint:trainee": "npm run lint --workspace=apps/datahub-trainee-app",
    "test:trainee": "npm run test --workspace=apps/datahub-trainee-app",
    "lint:packages": "npm run lint --workspace=packages/shared-types",
    "lint": "npm run lint:website && npm run lint:hr && npm run lint:admin && npm run lint:trainee && npm run lint:packages",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:packages": "npm run typecheck --workspace=packages/shared-types",
    "verify": "npm run typecheck && npm run lint && npm run build:website && npm run build:admin && npm run test:admin && npm run build:trainee && npm run test:trainee && npm run config:hr && npm run doctor:hr"
  },
  "engines": {
    "node": ">=20.19.4",
    "npm": ">=10"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
